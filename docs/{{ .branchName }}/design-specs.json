{
  "ticket": "TEST-2001",
  "title": "간단한 카운터 앱 만들기",
  "components": [
    {
      "name": "CounterDisplay",
      "type": "atom",
      "description": "숫자를 표시하는 디스플레이",
      "props": {
        "count": {
          "type": "number",
          "required": true,
          "description": "현재 카운터 값"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex justify-center items-center text-6xl font-bold text-gray-800 p-8 bg-white rounded-xl shadow-sm min-w-[200px]"
      },
      "children": [],
      "states": [
        "default"
      ],
      "accessibility": {
        "role": "status",
        "ariaLabel": "Current count value"
      }
    },
    {
      "name": "CounterButton",
      "type": "atom",
      "description": "+1, -1, Reset 기능을 수행하는 버튼",
      "props": {
        "label": {
          "type": "string",
          "required": true,
          "description": "버튼에 표시될 텍스트 (+1, -1, Reset)"
        },
        "onClick": {
          "type": "function",
          "required": true,
          "description": "클릭 이벤트 핸들러"
        },
        "variant": {
          "type": "string",
          "required": false,
          "description": "스타일 변형 (primary, secondary, danger 등)"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex justify-center items-center px-6 py-3 rounded-lg font-semibold text-white transition-transform hover:scale-105 active:scale-95 shadow-md"
      },
      "children": [],
      "states": [
        "default",
        "hover",
        "active",
        "focus"
      ],
      "accessibility": {
        "role": "button",
        "ariaLabel": "Counter action button"
      }
    },
    {
      "name": "CounterApp",
      "type": "page",
      "description": "카운터 앱의 메인 페이지 컨테이너",
      "props": {},
      "layout": {
        "display": "flex",
        "tailwind": "flex flex-col items-center justify-center min-h-screen bg-gray-50 gap-8 p-4"
      },
      "children": [
        "CounterDisplay",
        "CounterButton"
      ],
      "states": [
        "default"
      ],
      "accessibility": {
        "role": "main",
        "ariaLabel": "Counter application main page"
      }
    }
  ],
  "colorPalette": {
    "primary": "#3b82f6",
    "secondary": "#6b7280",
    "danger": "#ef4444",
    "background": "#f9fafb",
    "text": "#1f2937",
    "white": "#ffffff"
  },
  "interactions": [
    {
      "trigger": "click",
      "action": "Increment (+1) button increases the count state by 1"
    },
    {
      "trigger": "click",
      "action": "Decrement (-1) button decreases the count state by 1"
    },
    {
      "trigger": "click",
      "action": "Reset button sets the count state to 0"
    }
  ]
}