{
  "ticket": "BASEBALL",
  "title": "웹 기반 야구 게임",
  "description": "시간에 맞춰서 스크린을 탭하면 날아오는 공에 박자에 맞춰서 배팅을 휘두르는 게임. 점수는 홈런, 1~3루타, 스트라이크로 구분하고 기회는 3번.",
  "components": [
    {
      "name": "GamePage",
      "type": "page",
      "description": "야구 게임 전체 페이지. 게임 필드, HUD, 결과 화면을 포함하는 최상위 컨테이너.",
      "props": {},
      "layout": {
        "display": "flex",
        "tailwind": "flex flex-col items-center justify-between min-h-screen w-full bg-green-900 overflow-hidden select-none"
      },
      "children": [
        "GameHeader",
        "GameField",
        "BatterZone",
        "GameResultOverlay"
      ],
      "states": ["idle", "playing", "result"],
      "accessibility": {
        "role": "main",
        "ariaLabel": "야구 게임 메인 페이지"
      }
    },
    {
      "name": "GameHeader",
      "type": "organism",
      "description": "상단 HUD 영역. 현재 점수, 남은 기회(아웃 카운트), 현재 타격 결과 레이블을 표시.",
      "props": {
        "score": { "type": "number", "required": true, "description": "현재 누적 점수" },
        "attemptsLeft": { "type": "number", "required": true, "description": "남은 기회 수 (최대 3)" },
        "lastHitLabel": { "type": "string", "required": false, "description": "마지막 타격 결과 텍스트 (홈런, 1루타, 2루타, 3루타, 스트라이크)" }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex flex-row items-center justify-between w-full px-4 py-3 bg-black/40 backdrop-blur-sm"
      },
      "children": [
        "ScoreBadge",
        "HitResultLabel",
        "AttemptsIndicator"
      ],
      "states": ["default"],
      "accessibility": {
        "role": "banner",
        "ariaLabel": "게임 정보 헤더"
      }
    },
    {
      "name": "ScoreBadge",
      "type": "atom",
      "description": "현재 누적 점수를 표시하는 배지 컴포넌트.",
      "props": {
        "score": { "type": "number", "required": true, "description": "표시할 점수 값" }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex flex-col items-center gap-0.5"
      },
      "children": [],
      "states": ["default"],
      "accessibility": {
        "role": "status",
        "ariaLabel": "현재 점수",
        "ariaLive": "polite"
      },
      "visualSpec": {
        "label": "SCORE",
        "labelTailwind": "text-xs font-semibold tracking-widest text-yellow-300 uppercase",
        "valueTailwind": "text-3xl font-extrabold text-white tabular-nums"
      }
    },
    {
      "name": "HitResultLabel",
      "type": "atom",
      "description": "마지막 타격 결과(홈런, 1~3루타, 스트라이크)를 중앙에 강조 표시. 결과에 따라 색상이 달라짐.",
      "props": {
        "label": { "type": "string", "required": false, "description": "타격 결과 텍스트" },
        "variant": {
          "type": "enum",
          "values": ["homerun", "triple", "double", "single", "strike", "none"],
          "required": false,
          "description": "타격 결과 종류에 따른 시각적 변형"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex items-center justify-center"
      },
      "children": [],
      "states": ["none", "homerun", "triple", "double", "single", "strike"],
      "accessibility": {
        "role": "status",
        "ariaLive": "assertive",
        "ariaLabel": "타격 결과"
      },
      "visualSpec": {
        "variantStyles": {
          "homerun": "text-2xl font-black text-yellow-400 drop-shadow-[0_0_8px_rgba(250,204,21,0.9)] animate-bounce",
          "triple": "text-xl font-bold text-orange-400",
          "double": "text-xl font-bold text-green-400",
          "single": "text-xl font-bold text-blue-300",
          "strike": "text-xl font-bold text-red-400",
          "none": "invisible"
        }
      }
    },
    {
      "name": "AttemptsIndicator",
      "type": "molecule",
      "description": "남은 기회를 야구공 아이콘으로 시각화. 사용한 기회는 회색(아웃), 남은 기회는 흰색으로 표시.",
      "props": {
        "total": { "type": "number", "required": true, "description": "총 기회 수 (고정값 3)" },
        "remaining": { "type": "number", "required": true, "description": "남은 기회 수" }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex flex-row items-center gap-2"
      },
      "children": ["BallIcon"],
      "states": ["default"],
      "accessibility": {
        "role": "img",
        "ariaLabel": "남은 기회 표시"
      },
      "visualSpec": {
        "activeIconTailwind": "w-5 h-5 rounded-full bg-white border-2 border-yellow-300 shadow-md",
        "usedIconTailwind": "w-5 h-5 rounded-full bg-gray-600 border-2 border-gray-500 opacity-50"
      }
    },
    {
      "name": "BallIcon",
      "type": "atom",
      "description": "단일 야구공 아이콘 — 활성(남은 기회) 또는 비활성(사용한 기회) 상태.",
      "props": {
        "active": { "type": "boolean", "required": true, "description": "기회 남음 여부" }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex items-center justify-center"
      },
      "children": [],
      "states": ["active", "used"],
      "accessibility": {
        "role": "img",
        "ariaLabel": "야구공"
      }
    },
    {
      "name": "GameField",
      "type": "organism",
      "description": "공이 날아오는 메인 게임 필드. 원근감 있는 야구장 배경, 투구 궤도 레인, 날아오는 공 애니메이션을 포함. 탭 타이밍을 시각화하는 타이밍 바도 포함.",
      "props": {
        "isPlaying": { "type": "boolean", "required": true, "description": "게임 진행 중 여부" },
        "ballPosition": {
          "type": "object",
          "required": false,
          "description": "공의 현재 위치 {x: number, y: number} (퍼센트 기준)"
        },
        "ballScale": { "type": "number", "required": false, "description": "공의 크기 비율 (원근감 표현, 0~1)" }
      },
      "layout": {
        "display": "flex",
        "tailwind": "relative flex flex-col items-center justify-end w-full flex-1 overflow-hidden"
      },
      "children": [
        "FieldBackground",
        "PitchLane",
        "BaseballBall",
        "TimingBar"
      ],
      "states": ["idle", "pitching", "hit", "strike"],
      "accessibility": {
        "role": "region",
        "ariaLabel": "게임 필드 — 공이 날아오는 영역"
      }
    },
    {
      "name": "FieldBackground",
      "type": "atom",
      "description": "야구장 원근감 배경. 잔디 그라데이션과 내야/외야 구분선을 SVG 또는 CSS로 표현.",
      "props": {},
      "layout": {
        "display": "flex",
        "tailwind": "absolute inset-0 w-full h-full"
      },
      "children": [],
      "states": ["default"],
      "accessibility": {
        "role": "img",
        "ariaLabel": "야구장 배경",
        "ariaHidden": true
      },
      "visualSpec": {
        "backgroundTailwind": "bg-gradient-to-b from-green-700 via-green-600 to-green-500",
        "infield": "absolute bottom-0 left-1/2 -translate-x-1/2 w-3/4 h-2/5 bg-amber-800/40 rounded-t-full",
        "pitcherMound": "absolute bottom-1/3 left-1/2 -translate-x-1/2 w-8 h-4 bg-amber-700/60 rounded-full"
      }
    },
    {
      "name": "PitchLane",
      "type": "atom",
      "description": "투수-타자 사이의 투구 궤도 레인을 나타내는 가이드 라인 (선택적 시각 요소).",
      "props": {
        "visible": { "type": "boolean", "required": false, "description": "레인 표시 여부" }
      },
      "layout": {
        "display": "flex",
        "tailwind": "absolute bottom-0 left-1/2 -translate-x-1/2 flex flex-col items-center"
      },
      "children": [],
      "states": ["visible", "hidden"],
      "accessibility": {
        "role": "presentation",
        "ariaHidden": true
      },
      "visualSpec": {
        "laneTailwind": "w-1 h-full bg-white/10 rounded-full"
      }
    },
    {
      "name": "BaseballBall",
      "type": "atom",
      "description": "화면 위에서 아래(타자 방향)로 날아오는 야구공. 원근감을 위해 멀리서 작게 시작해 점점 커지며 중앙 하단으로 이동.",
      "props": {
        "x": { "type": "number", "required": true, "description": "공의 수평 위치 (% 기준)" },
        "y": { "type": "number", "required": true, "description": "공의 수직 위치 (% 기준)" },
        "scale": { "type": "number", "required": true, "description": "공의 크기 배율 (0.2 ~ 1.5)" },
        "isHit": { "type": "boolean", "required": false, "description": "타격 성공 여부 (히트 이펙트 트리거)" }
      },
      "layout": {
        "display": "flex",
        "tailwind": "absolute transition-none pointer-events-none"
      },
      "children": [],
      "states": ["flying", "hit", "strike"],
      "accessibility": {
        "role": "img",
        "ariaLabel": "날아오는 야구공",
        "ariaHidden": true
      },
      "visualSpec": {
        "ballBaseTailwind": "rounded-full bg-white border border-gray-300 shadow-lg",
        "baseSize": "w-6 h-6",
        "stitchColor": "border-red-400",
        "hitEffectTailwind": "ring-4 ring-yellow-300 ring-opacity-80 scale-150 opacity-0 transition-all duration-300"
      }
    },
    {
      "name": "TimingBar",
      "type": "molecule",
      "description": "타이밍 입력을 안내하는 수평 바. 좌우로 이동하는 마커와 히트 존(중앙 강조 영역)으로 구성. 타이밍 정확도에 따라 홈런~스트라이크 판정.",
      "props": {
        "markerPosition": { "type": "number", "required": true, "description": "마커의 현재 위치 (0~100, %" },
        "isActive": { "type": "boolean", "required": true, "description": "타이밍 바 활성화 여부" }
      },
      "layout": {
        "display": "flex",
        "tailwind": "relative w-4/5 max-w-sm h-8 mx-auto mb-4 rounded-full overflow-hidden"
      },
      "children": [
        "TimingTrack",
        "HitZone",
        "TimingMarker"
      ],
      "states": ["active", "inactive", "perfect", "miss"],
      "accessibility": {
        "role": "meter",
        "ariaLabel": "타이밍 게이지",
        "ariaValuemin": 0,
        "ariaValuemax": 100
      }
    },
    {
      "name": "TimingTrack",
      "type": "atom",
      "description": "타이밍 바의 배경 트랙.",
      "props": {},
      "layout": {
        "display": "flex",
        "tailwind": "absolute inset-0 bg-gray-700 rounded-full"
      },
      "children": [],
      "states": ["default"],
      "accessibility": {
        "role": "presentation",
        "ariaHidden": true
      }
    },
    {
      "name": "HitZone",
      "type": "molecule",
      "description": "타이밍 바 내 판정 구역. 중앙에서 바깥쪽으로 홈런(완벽) → 3루타 → 2루타 → 1루타 → 스트라이크 순서로 색상 구분된 구역 표시.",
      "props": {},
      "layout": {
        "display": "flex",
        "tailwind": "absolute inset-y-0 left-1/2 -translate-x-1/2 flex flex-row items-center"
      },
      "children": [],
      "states": ["default"],
      "accessibility": {
        "role": "presentation",
        "ariaHidden": true
      },
      "visualSpec": {
        "zones": [
          { "id": "homerun", "widthPercent": 10, "tailwind": "h-full bg-yellow-400" },
          { "id": "triple", "widthPercent": 16, "tailwind": "h-full bg-orange-400" },
          { "id": "double", "widthPercent": 22, "tailwind": "h-full bg-green-400" },
          { "id": "single", "widthPercent": 30, "tailwind": "h-full bg-blue-400" }
        ],
        "outerZoneTailwind": "h-full flex-1 bg-red-700/60"
      }
    },
    {
      "name": "TimingMarker",
      "type": "atom",
      "description": "타이밍 바 위를 좌우로 왕복하는 마커. 플레이어는 마커가 히트 존에 있을 때 탭해야 함.",
      "props": {
        "position": { "type": "number", "required": true, "description": "마커 위치 (0~100, %)" }
      },
      "layout": {
        "display": "flex",
        "tailwind": "absolute top-0 bottom-0 w-1 bg-white rounded-full shadow-[0_0_6px_2px_rgba(255,255,255,0.8)]"
      },
      "children": [],
      "states": ["default"],
      "accessibility": {
        "role": "presentation",
        "ariaHidden": true
      }
    },
    {
      "name": "BatterZone",
      "type": "organism",
      "description": "화면 하단의 타자 영역. 배팅 버튼(탭 영역), 타자 실루엣 이미지, 배트 스윙 애니메이션을 포함. 플레이어가 이 영역을 탭하여 스윙.",
      "props": {
        "isSwinging": { "type": "boolean", "required": false, "description": "스윙 애니메이션 실행 여부" },
        "isDisabled": { "type": "boolean", "required": false, "description": "입력 비활성화 여부 (결과 표시 중 등)" }
      },
      "layout": {
        "display": "flex",
        "tailwind": "relative flex items-end justify-center w-full h-40 bg-gradient-to-t from-black/60 to-transparent"
      },
      "children": [
        "BatterSilhouette",
        "SwingButton"
      ],
      "states": ["idle", "swinging", "disabled"],
      "accessibility": {
        "role": "region",
        "ariaLabel": "타자 영역"
      }
    },
    {
      "name": "BatterSilhouette",
      "type": "atom",
      "description": "타자 캐릭터 실루엣. 스윙 시 배트를 휘두르는 애니메이션 재생. SVG 또는 이미지로 구현.",
      "props": {
        "isSwinging": { "type": "boolean", "required": false, "description": "스윙 중 여부" }
      },
      "layout": {
        "display": "flex",
        "tailwind": "absolute bottom-0 left-1/2 -translate-x-1/2 w-24 h-28"
      },
      "children": [],
      "states": ["idle", "swinging"],
      "accessibility": {
        "role": "img",
        "ariaLabel": "타자 캐릭터",
        "ariaHidden": true
      },
      "visualSpec": {
        "idleTailwind": "opacity-90",
        "swingTailwind": "animate-[swing_0.25s_ease-out]",
        "colorScheme": "fill-gray-800 stroke-gray-600"
      }
    },
    {
      "name": "SwingButton",
      "type": "atom",
      "description": "전체 BatterZone을 덮는 투명 탭 버튼. 시각적 피드백 없이 탭/클릭 이벤트만 캡처. 접근성을 위해 aria-label 포함.",
      "props": {
        "onSwing": { "type": "function", "required": true, "description": "탭/클릭 시 실행되는 스윙 핸들러" },
        "disabled": { "type": "boolean", "required": false, "description": "버튼 비활성화 여부" }
      },
      "layout": {
        "display": "flex",
        "tailwind": "absolute inset-0 w-full h-full cursor-pointer bg-transparent active:bg-white/5 transition-colors"
      },
      "children": [],
      "states": ["default", "active", "disabled"],
      "accessibility": {
        "role": "button",
        "ariaLabel": "배팅하기 — 탭하여 스윙",
        "tabIndex": 0
      }
    },
    {
      "name": "GameResultOverlay",
      "type": "organism",
      "description": "게임 종료 후 최종 결과를 보여주는 전체 화면 오버레이. 최종 점수, 각 타석 결과 목록, 홈으로 돌아가기/다시 하기 버튼 포함.",
      "props": {
        "isVisible": { "type": "boolean", "required": true, "description": "오버레이 표시 여부" },
        "finalScore": { "type": "number", "required": true, "description": "최종 점수" },
        "hits": {
          "type": "array",
          "required": true,
          "description": "각 타석 결과 배열. 예: ['홈런', '2루타', '스트라이크']"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "fixed inset-0 z-50 flex flex-col items-center justify-center bg-black/80 backdrop-blur-sm px-6"
      },
      "children": [
        "ResultCard"
      ],
      "states": ["hidden", "visible"],
      "accessibility": {
        "role": "dialog",
        "ariaModal": true,
        "ariaLabel": "게임 결과 화면"
      }
    },
    {
      "name": "ResultCard",
      "type": "molecule",
      "description": "게임 결과를 담은 카드 UI. 등급 아이콘, 최종 점수, 타석별 결과, 액션 버튼을 세로로 나열.",
      "props": {
        "finalScore": { "type": "number", "required": true, "description": "최종 점수" },
        "hits": { "type": "array", "required": true, "description": "타석별 결과 배열" },
        "onRestart": { "type": "function", "required": true, "description": "다시 하기 버튼 핸들러" },
        "onHome": { "type": "function", "required": true, "description": "홈으로 버튼 핸들러" }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex flex-col items-center gap-6 w-full max-w-xs bg-gray-900 rounded-2xl p-8 shadow-2xl border border-gray-700"
      },
      "children": [
        "ResultGradeIcon",
        "FinalScoreDisplay",
        "HitHistoryList",
        "ResultActionButtons"
      ],
      "states": ["default"],
      "accessibility": {
        "role": "document",
        "ariaLabel": "게임 결과 카드"
      }
    },
    {
      "name": "ResultGradeIcon",
      "type": "atom",
      "description": "최종 점수에 따른 등급 아이콘 또는 이모티콘. 홈런 비율에 따라 MVP / Good / Try Again 등급 표시.",
      "props": {
        "grade": {
          "type": "enum",
          "values": ["mvp", "good", "tryAgain"],
          "required": true,
          "description": "결과 등급"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex items-center justify-center w-20 h-20 rounded-full"
      },
      "children": [],
      "states": ["mvp", "good", "tryAgain"],
      "accessibility": {
        "role": "img",
        "ariaLabel": "게임 결과 등급 아이콘"
      },
      "visualSpec": {
        "gradeStyles": {
          "mvp": "bg-yellow-400 text-5xl shadow-[0_0_20px_rgba(250,204,21,0.7)]",
          "good": "bg-green-500 text-4xl",
          "tryAgain": "bg-gray-600 text-4xl"
        },
        "gradeEmoji": {
          "mvp": "🏆",
          "good": "⭐",
          "tryAgain": "🔄"
        }
      }
    },
    {
      "name": "FinalScoreDisplay",
      "type": "atom",
      "description": "최종 점수를 크게 표시하는 컴포넌트.",
      "props": {
        "score": { "type": "number", "required": true, "description": "최종 점수 값" }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex flex-col items-center gap-1"
      },
      "children": [],
      "states": ["default"],
      "accessibility": {
        "role": "status",
