{
  "ticket": "BASEBALL-008",
  "title": "웹 기반 야구 게임 — 타이밍 탭 배팅",
  "description": "시간에 맞춰 스크린을 탭하면 날아오는 공에 박자에 맞춰 배트를 휘두르는 리듬 기반 야구 게임. 타격 결과는 홈런 / 3루타 / 2루타 / 1루타 / 스트라이크로 판정되며, 기회는 총 3번(3타석)이다.",
  "atomicDesignOverview": {
    "atoms":     ["BallIcon", "StrikeIndicatorDot", "ScoreLabel", "TimingCursor", "HitZoneMarker", "ActionButton", "ResultBadge", "CountdownTimer"],
    "molecules": ["TimingBar", "OutChanceRow", "ScoreBoard", "BallPitchCanvas", "ResultOverlay", "RhythmMetronome"],
    "organisms": ["GameHUD", "BattingStage", "StartScreen", "ResultScreen"],
    "templates": ["GameTemplate"],
    "pages":     ["BaseballGamePage"]
  },
  "components": [
    {
      "name": "BallIcon",
      "type": "atom",
      "description": "야구공 한 개를 표현하는 SVG 기반 원형 아이콘. OutChanceRow와 BallPitchCanvas에서 재사용",
      "props": {
        "size": {
          "type": "number",
          "required": false,
          "default": 24,
          "description": "아이콘 직경 (px 단위 숫자, Tailwind dynamic size로 변환)"
        },
        "variant": {
          "type": "string",
          "required": false,
          "default": "active",
          "description": "'active' | 'used' | 'flying' — 공 상태에 따른 스타일 분기"
        }
      },
      "layout": {
        "display": "inline-block",
        "tailwind": "rounded-full shrink-0"
      },
      "variants": {
        "active":  { "tailwind": "bg-white border-2 border-gray-300 shadow-inner" },
        "used":    { "tailwind": "bg-red-500 border-2 border-red-700 opacity-80 shadow-inner" },
        "flying":  { "tailwind": "bg-white border-4 border-gray-200 shadow-xl" }
      },
      "states": ["active", "used", "flying"],
      "accessibility": {
        "role": "img",
        "ariaLabel": "야구공"
      }
    },
    {
      "name": "StrikeIndicatorDot",
      "type": "atom",
      "description": "타석당 스트라이크/기회 소진 여부를 표시하는 단일 점. OutChanceRow 내에서 3개가 나열됨",
      "props": {
        "isUsed": {
          "type": "boolean",
          "required": true,
          "description": "해당 기회 소진 여부 (true: 빨간 X, false: 흰 원)"
        },
        "index": {
          "type": "number",
          "required": true,
          "description": "0-based 인덱스 (접근성 레이블용)"
        }
      },
      "layout": {
        "display": "inline-flex",
        "tailwind": "items-center justify-center w-7 h-7 rounded-full font-bold text-sm transition-all duration-300"
      },
      "variants": {
        "active": { "tailwind": "bg-white border-2 border-gray-400 text-transparent" },
        "used":   { "tailwind": "bg-red-500 border-2 border-red-600 text-white scale-110 shadow-md" }
      },
      "content": {
        "active": "",
        "used": "✕"
      },
      "states": ["active", "used"],
      "accessibility": {
        "role": "img",
        "ariaLabel": "{index + 1}번 기회 — {isUsed ? '소진' : '남음'}"
      }
    },
    {
      "name": "ScoreLabel",
      "type": "atom",
      "description": "개별 타격 결과를 뱃지 형태로 표시. 결과 유형에 따라 색상·텍스트·애니메이션 변화",
      "props": {
        "result": {
          "type": "string",
          "required": true,
          "description": "'homerun' | '3base' | '2base' | '1base' | 'strike'"
        },
        "size": {
          "type": "string",
          "required": false,
          "default": "md",
          "description": "'sm' | 'md' | 'lg' — 사용 맥락에 따른 크기 조정"
        }
      },
      "layout": {
        "display": "inline-flex",
        "tailwind": "items-center justify-center px-4 py-2 rounded-full font-extrabold tracking-widest shadow-lg select-none"
      },
      "variants": {
        "homerun": {
          "tailwind": "bg-yellow-400 text-yellow-900 ring-4 ring-yellow-200 animate-bounce text-3xl sm:text-4xl",
          "label": "⚾ HOMERUN!"
        },
        "3base": {
          "tailwind": "bg-green-500 text-white ring-4 ring-green-300 text-2xl sm:text-3xl",
          "label": "3루타!"
        },
        "2base": {
          "tailwind": "bg-blue-500 text-white ring-4 ring-blue-300 text-2xl sm:text-3xl",
          "label": "2루타!"
        },
        "1base": {
          "tailwind": "bg-indigo-400 text-white ring-4 ring-indigo-300 text-2xl sm:text-3xl",
          "label": "1루타!"
        },
        "strike": {
          "tailwind": "bg-red-500 text-white ring-4 ring-red-300 text-2xl sm:text-3xl animate-shake",
          "label": "STRIKE!"
        }
      },
      "sizeMap": {
        "sm": "text-base px-3 py-1",
        "md": "text-2xl px-4 py-2",
        "lg": "text-4xl px-6 py-3"
      },
      "states": ["visible", "hidden"],
      "accessibility": {
        "role": "status",
        "ariaLive": "polite",
        "ariaLabel": "타격 결과: {result}"
      }
    },
    {
      "name": "TimingCursor",
      "type": "atom",
      "description": "타이밍 바 위에서 좌→우로 이동하는 공 마커. progress(0~1)에 따라 translateX 위치 결정",
      "props": {
        "progress": {
          "type": "number",
          "required": true,
          "description": "0~1 사이 이동 비율"
        },
        "inHitZone": {
          "type": "boolean",
          "required": true,
          "description": "현재 타격 가능 구역 진입 여부 (시각 강조용)"
        },
        "inPerfectZone": {
          "type": "boolean",
          "required": true,
          "description": "현재 홈런 구역 진입 여부"
        }
      },
      "layout": {
        "display": "block",
        "tailwind": "absolute top-1/2 -translate-y-1/2 w-5 h-5 rounded-full shadow-md border-2 transition-colors duration-75"
      },
      "variants": {
        "default":     { "tailwind": "bg-white border-gray-400" },
        "inHitZone":   { "tailwind": "bg-green-300 border-green-600 scale-110 shadow-green-400/60" },
        "inPerfect":   { "tailwind": "bg-yellow-300 border-yellow-500 scale-125 shadow-yellow-400/80 animate-pulse" }
      },
      "states": ["default", "inHitZone", "inPerfect"],
      "accessibility": {
        "role": "presentation",
        "ariaHidden": true
      }
    },
    {
      "name": "HitZoneMarker",
      "type": "atom",
      "description": "타이밍 바 내부에 렌더링되는 타격 가능 구역 및 홈런 구역 표시 레이어",
      "props": {
        "hitZoneStart": {
          "type": "number",
          "required": true,
          "description": "타격 존 시작 비율 (예: 0.38)"
        },
        "hitZoneEnd": {
          "type": "number",
          "required": true,
          "description": "타격 존 끝 비율 (예: 0.62)"
        },
        "perfectZoneStart": {
          "type": "number",
          "required": true,
          "description": "홈런 존 시작 비율 (예: 0.46)"
        },
        "perfectZoneEnd": {
          "type": "number",
          "required": true,
          "description": "홈런 존 끝 비율 (예: 0.54)"
        }
      },
      "layout": {
        "display": "block",
        "tailwind": "absolute inset-y-0"
      },
      "children": [
        {
          "element": "div",
          "description": "초록 타격 가능 존 (hitZoneStart ~ hitZoneEnd)",
          "tailwind": "absolute inset-y-0 bg-green-400 opacity-40 rounded"
        },
        {
          "element": "div",
          "description": "노란 홈런 존 (perfectZoneStart ~ perfectZoneEnd)",
          "tailwind": "absolute inset-y-0 bg-yellow-300 opacity-70 rounded"
        }
      ],
      "states": ["default"],
      "accessibility": {
        "role": "presentation",
        "ariaHidden": true
      }
    },
    {
      "name": "ActionButton",
      "type": "atom",
      "description": "플레이어가 탭/클릭하여 배트를 휘두르는 메인 인터랙션 버튼. 모바일 터치에 최적화된 대형 원형 버튼",
      "props": {
        "disabled": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "비활성 여부 (공 미발사 상태 등)"
        },
        "swinging": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "배트 휘두르기 애니메이션 재생 중 여부"
        },
        "onSwing": {
          "type": "function",
          "required": true,
          "description": "탭/클릭 시 배팅 판정 트리거 핸들러"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "items-center justify-center w-40 h-40 sm:w-52 sm:h-52 rounded-full cursor-pointer select-none transition-all duration-75 touch-none"
      },
      "variants": {
        "default":   { "tailwind": "bg-amber-500 hover:bg-amber-400 ring-4 ring-amber-300 shadow-xl text-white" },
        "swinging":  { "tailwind": "bg-amber-300 scale-90 ring-4 ring-amber-200 shadow-inner" },
        "disabled":  { "tailwind": "bg-gray-700 opacity-40 cursor-not-allowed ring-4 ring-gray-600 text-gray-500" }
      },
      "children": [
        {
          "element": "span",
          "content": "🏏",
          "tailwind": "text-5xl sm:text-6xl drop-shadow pointer-events-none"
        }
      ],
      "states": ["default", "swinging", "disabled"],
      "accessibility": {
        "role": "button",
        "ariaLabel": "배트 휘두르기 — 탭 또는 클릭",
        "ariaDisabled": "{disabled}",
        "ariaPressed": "{swinging}"
      }
    },
    {
      "name": "ResultBadge",
      "type": "atom",
      "description": "게임 최종 결과 등급을 크고 화려한 뱃지로 표시 (ResultScreen 상단 강조 요소)",
      "props": {
        "grade": {
          "type": "string",
          "required": true,
          "description": "'legend' | 'great' | 'good' | 'out' — 최종 등급"
        },
        "label": {
          "type": "string",
          "required": true,
          "description": "뱃지에 표시할 텍스트 (예: '전설의 타자!')"
        },
        "icon": {
          "type": "string",
          "required": false,
          "description": "이모지 아이콘 (예: '🏆')"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex-col items-center gap-2 px-10 py-5 rounded-3xl shadow-2xl font-black text-center"
      },
      "variants": {
        "legend": { "tailwind": "bg-gradient-to-br from-yellow-400 to-amber-500 text-yellow-900 ring-4 ring-yellow-200 text-4xl" },
        "great":  { "tailwind": "bg-gradient-to-br from-green-400 to-emerald-500 text-green-900 ring-4 ring-green-200 text-3xl" },
        "good":   { "tailwind": "bg-gradient-to-br from-blue-400 to-sky-500 text-blue-900 ring-4 ring-blue-200 text-3xl" },
        "out":    { "tailwind": "bg-gradient-to-br from-gray-500 to-gray-700 text-white ring-4 ring-gray-400 text-3xl" }
      },
      "gradeMap": {
        "legend": { "condition": "3타석 모두 홈런 또는 3루타 이상",  "label": "전설의 타자!",   "icon": "🏆" },
        "great":  { "condition": "총점 500점 이상",                   "label": "강타자!",         "icon": "💪" },
        "good":   { "condition": "총점 100점 이상",                   "label": "선전했어요!",     "icon": "👍" },
        "out":    { "condition": "총점 0점 (전부 스트라이크)",         "label": "삼진 아웃...",    "icon": "😢" }
      },
      "states": ["default"],
      "accessibility": {
        "role": "status",
        "ariaLabel": "최종 결과 등급: {grade}"
      }
    },
    {
      "name": "CountdownTimer",
      "type": "atom",
      "description": "타석 시작 전 3→2→1→GO! 카운트다운을 화면 중앙에 표시하는 숫자 애니메이션",
      "props": {
        "count": {
          "type": "number | string",
          "required": true,
          "description": "표시할 카운트 값 (3, 2, 1, 'GO!')"
        },
        "visible": {
          "type": "boolean",
          "required": true,
          "description": "카운트다운 표시 여부"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "absolute inset-0 items-center justify-center z-40 pointer-events-none"
      },
      "children": [
        {
          "element": "span",
          "tailwind": "text-8xl sm:text-9xl font-black text-white drop-shadow-2xl animate-ping-once",
          "content": "{count}"
        }
      ],
      "states": ["hidden", "counting", "go"],
      "accessibility": {
        "role": "status",
        "ariaLive": "assertive",
        "ariaLabel": "타석 시작 카운트다운: {count}"
      }
    },
    {
      "name": "TimingBar",
      "type": "molecule",
      "description": "공이 날아오는 타이밍을 시각화하는 수평 진행 바. 타격 존과 홈런 존을 색상으로 구분하고, 이동하는 커서가 올바른 타이밍을 안내함",
      "props": {
        "progress": {
          "type": "number",
          "required": true,
          "description": "커서의 현재 위치 비율 (0~1)"
        },
        "hitZoneStart":    { "type": "number", "required": true,  "description": "타격 가능 존 시작 (예: 0.38)" },
        "hitZoneEnd":      { "type": "number", "required": true,  "description": "타격 가능 존 끝 (예: 0.62)" },
        "perfectZoneStart":{ "type": "number", "required": true,  "description": "홈런 존 시작 (예: 0.46)" },
        "perfectZoneEnd":  { "type": "number", "required": true,  "description": "홈런 존 끝 (예: 0.54)" },
        "active": {
          "type": "boolean",
          "required": true,
          "description": "투구 진행 중 여부 (false: 바 비활성화)"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "relative w-full h-8 rounded-full bg-gray-700 overflow-visible shadow-inner"
      },
      "children": [
        { "name": "HitZoneMarker", "type": "atom" },
        { "name": "TimingCursor",  "type": "atom" }
      ],
      "states": ["idle", "moving", "in-hit-zone", "in-perfect-zone", "expired"],
      "accessibility": {
        "role": "progressbar",
        "ariaLabel": "타이밍 바 — 공이 타격 존에 들어오면 배트를 휘두르세요",
        "ariaValueMin": "0",
        "ariaValueMax": "100",
        "ariaValueNow": "{Math.round(progress * 100)}"
      }
    },
    {
      "name": "OutChanceRow",
      "type": "molecule",
      "description": "남은 기회(3번)를 StrikeIndicatorDot 3개로 수평 나열하여 표시하는 기회 표시줄",
      "props": {
        "totalChances": {
          "type": "number",
          "required": false,
          "default": 3,
          "description": "전체 기회 수"
        },
        "usedChances": {
          "type": "number",
          "required": true,
          "description": "이미 소진된 기회 수"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "items-center gap-2"
      },
      "children": [
        {
          "name": "StrikeIndicatorDot",
          "type": "atom",
          "repeat": "{totalChances}",
          "description": "index < usedChances이면 isUsed=true"
        }
      ],
      "states": ["full", "partial", "empty"],
      "accessibility": {
        "role": "group",
        "ariaLabel": "기회 {totalChances - usedChances}번 남음"
      }
    },
    {
      "name": "ScoreBoard",
      "type": "molecule",
      "description": "현재 점수 · 타석 번호 · 남은 기회를 하나의 HUD 패널로 통합 표시",
      "props": {
        "score":          { "type": "number", "required": true, "description": "누적 점수" },
        "currentInning":  { "type": "number", "required": true, "description": "현재 타석 (1~3)" },
        "usedChances":    { "type": "number", "required": true, "description": "소진된 기회 수" }
      },
      "layout": {
        "display": "flex",
        "tailwind": "items-center justify-between w-full px-4 py-3 bg-gray-900/80 backdrop-blur rounded-2xl shadow-lg"
      },
      "children": [
        {
          "element": "div",
          "tailwind": "flex flex-col items-start gap-0.5",
          "children": [
            { "element": "span", "tailwind": "text-xs text-gray-400 uppercase tracking-widest", "content": "SCORE" },
            { "element": "span", "tailwind": "text-3xl font-black text-yellow-300 tabular-nums", "content": "{score}" }
          ]
        },
        {
          "element": "div",
          "tailwind": "flex flex-col items-center gap-0.5",
          "children": [
            { "element": "span", "tailwind": "text-xs text-gray-400 uppercase tracking-widest", "content": "INNING" },
            { "element": "span", "tailwind": "text-3xl font-black text-white tabular-nums",     "content": "{currentInning} / 3" }
          ]
        },
        {
          "element": "div",
          "tailwind": "flex flex-col items-end gap-1.5",
          "children": [
            { "element": "span", "tailwind": "text-xs text-gray-400 uppercase tracking-widest", "content": "CHANCE" },
            { "name": "OutChanceRow", "type": "molecule" }
          ]
        }
      ],
      "states": ["default", "last-chance"],
      "accessibility": {
        "role": "region",
        "ariaLabel": "점수판 — 현재 점수, 타석, 남은 기회 표시"
      }
    },
    {
      "name": "BallPitchCanvas",
      "type": "molecule",
      "description": "투수 마운드에서 타자 방향으로 날아오는 야구공 애니메이션 영역. 공이 progress에 따라 원근감 있게 커지며 접근. 야구장 배경 그래픽 포함",
      "props": {
        "pitching": {
          "type": "boolean",
          "required": true,
          "description": "투구 진행 중 여부"
        },
        "progress": {
          "type": "number",
          "required": true,
          "description": "0~1, 1에 가까울수록 공이 타자에게 근접"
        },
        "hitResult": {
          "type": "string | null",
          "required": false,
          "description": "타격 결과 (null이면 아직 판정 전)"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "relative w-full aspect-[4/3] sm:aspect-video bg-gradient-to-b from-sky-500 via-sky-300 to-green-600 rounded-3xl overflow-hidden shadow-2xl"
      },
      "children": [
        {
          "element": "div",
          "description": "야구장 다이아몬드 배경 (SVG 또는 CSS 원근 표현)",
          "tailwind": "absolute inset-0 opacity-50 pointer-events-none"
        },
        {
          "element": "div",
          "description": "투수 마운드 원형 표식",
          "tailwind": "absolute top-1/4 left-1/2 -translate-x-1/2 w-8 h-4 rounded-full bg-amber-100 opacity-60"
        },
        {
          "name": "BallIcon",
          "type": "atom",
          "variant": "flying",
          "description": "progress에 따라 크기(w-3→w-16)와 위치(top-1/4→top-1/2) 변화하는 공",
          "tailwind": "absolute transition-all duration-100"
        },
        {
          "element": "div",
          "description": "투구 대기 상태 — 'READY...' 텍스트",
          "tailwind": "absolute inset-0 flex items-center justify-center text-white/70 text-xl font-bold",
          "visibleWhen": "!pitching && !hitResult"
        },
        {
          "element": "div",
          "description": "타격 성공 시 공이 날아가는 방향 이펙트 (arc 궤적 SVG 라인 또는 파티클)",
          "tailwind": "absolute inset-0 pointer-events-none",
          "visibleWhen": "hitResult && hitResult !== 'strike'"
        }
      ],
