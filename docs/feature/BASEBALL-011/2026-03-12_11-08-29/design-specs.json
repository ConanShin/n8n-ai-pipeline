{
  "ticket": "BASEBALL-011",
  "title": "웹 기반 야구 게임",
  "description": "시간에 맞춰서 스크린을 탭하면 날아오는 공에 박자에 맞춰서 배팅을 휘두르는 리듬 타격 게임. 점수는 홈런 / 1~3루타 / 스트라이크로 구분하며 기회(아웃)는 총 3번.",
  "components": [
    {
      "name": "GamePage",
      "type": "page",
      "description": "야구 게임 전체 화면을 감싸는 최상위 페이지 컴포넌트. 게임 상태(대기 / 진행 중 / 결과)를 관리하는 컨테이너.",
      "props": {
        "gameState": {
          "type": "'idle' | 'playing' | 'result'",
          "required": true,
          "description": "현재 게임 진행 상태"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex flex-col min-h-screen w-full bg-gray-950 text-white overflow-hidden select-none"
      },
      "children": [
        "GameHeader",
        "GameField",
        "GameHUD",
        "ResultOverlay"
      ],
      "states": ["idle", "playing", "result"],
      "accessibility": {
        "role": "main",
        "ariaLabel": "야구 게임 메인 화면"
      }
    },
    {
      "name": "GameHeader",
      "type": "organism",
      "description": "게임 상단 정보 영역. 현재 점수, 스트라이크 카운트, 남은 기회(아웃 수)를 표시.",
      "props": {
        "score": {
          "type": "number",
          "required": true,
          "description": "현재 누적 점수"
        },
        "strikes": {
          "type": "number",
          "required": true,
          "description": "현재 스트라이크 수 (0~3)"
        },
        "outs": {
          "type": "number",
          "required": true,
          "description": "현재 아웃 수 (0~3, 최대 3회 기회)"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex items-center justify-between w-full px-4 py-3 bg-gray-900 border-b border-gray-700 z-10"
      },
      "children": [
        "ScoreDisplay",
        "CountBoard"
      ],
      "states": ["default"],
      "accessibility": {
        "role": "banner",
        "ariaLabel": "게임 상태 헤더"
      }
    },
    {
      "name": "ScoreDisplay",
      "type": "molecule",
      "description": "현재 누적 점수를 크게 표시하는 컴포넌트.",
      "props": {
        "score": {
          "type": "number",
          "required": true,
          "description": "표시할 점수 값"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex flex-col items-start gap-0.5"
      },
      "children": [
        {
          "element": "span",
          "tailwind": "text-xs font-semibold uppercase tracking-widest text-yellow-400",
          "content": "SCORE"
        },
        {
          "element": "span",
          "tailwind": "text-4xl font-black tabular-nums text-white leading-none",
          "content": "{score}"
        }
      ],
      "states": ["default"],
      "accessibility": {
        "role": "status",
        "ariaLabel": "현재 점수",
        "ariaLive": "polite"
      }
    },
    {
      "name": "CountBoard",
      "type": "molecule",
      "description": "스트라이크 카운트와 남은 기회(아웃)를 아이콘 도트(●/○)로 시각화하는 컴포넌트.",
      "props": {
        "strikes": {
          "type": "number",
          "required": true,
          "description": "현재 스트라이크 수"
        },
        "maxStrikes": {
          "type": "number",
          "required": false,
          "description": "최대 스트라이크 수 (기본값 3)"
        },
        "outs": {
          "type": "number",
          "required": true,
          "description": "현재 아웃 수"
        },
        "maxOuts": {
          "type": "number",
          "required": false,
          "description": "최대 아웃 수 (기본값 3)"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex flex-col items-end gap-1"
      },
      "children": [
        "StrikeIndicator",
        "OutIndicator"
      ],
      "states": ["default"],
      "accessibility": {
        "role": "group",
        "ariaLabel": "스트라이크 및 아웃 현황"
      }
    },
    {
      "name": "StrikeIndicator",
      "type": "atom",
      "description": "현재 스트라이크 수를 빨간 도트로 시각화.",
      "props": {
        "active": {
          "type": "number",
          "required": true,
          "description": "활성화된(채워진) 도트 수"
        },
        "total": {
          "type": "number",
          "required": true,
          "description": "전체 도트 수"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex items-center gap-1.5"
      },
      "children": [
        {
          "element": "span",
          "tailwind": "text-xs font-semibold text-red-400 mr-1",
          "content": "S"
        },
        {
          "element": "span",
          "note": "활성 도트 (active 개수만큼 반복)",
          "tailwind": "w-3 h-3 rounded-full bg-red-500"
        },
        {
          "element": "span",
          "note": "비활성 도트 (total - active 개수만큼 반복)",
          "tailwind": "w-3 h-3 rounded-full bg-gray-600"
        }
      ],
      "states": ["default"],
      "accessibility": {
        "ariaLabel": "스트라이크 {active}/{total}"
      }
    },
    {
      "name": "OutIndicator",
      "type": "atom",
      "description": "남은 기회(아웃 수)를 주황 도트로 시각화.",
      "props": {
        "active": {
          "type": "number",
          "required": true,
          "description": "활성화된(채워진) 아웃 도트 수"
        },
        "total": {
          "type": "number",
          "required": true,
          "description": "전체 아웃 기회 수 (기본 3)"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex items-center gap-1.5"
      },
      "children": [
        {
          "element": "span",
          "tailwind": "text-xs font-semibold text-orange-400 mr-1",
          "content": "O"
        },
        {
          "element": "span",
          "note": "활성 아웃 도트",
          "tailwind": "w-3 h-3 rounded-full bg-orange-500"
        },
        {
          "element": "span",
          "note": "비활성 도트",
          "tailwind": "w-3 h-3 rounded-full bg-gray-600"
        }
      ],
      "states": ["default"],
      "accessibility": {
        "ariaLabel": "아웃 {active}/{total}"
      }
    },
    {
      "name": "GameField",
      "type": "organism",
      "description": "야구장 배경과 공 투구 애니메이션, 타격 판정 영역을 포함하는 메인 게임 플레이 영역. 사용자가 탭/클릭하는 핵심 인터랙션 공간.",
      "props": {
        "isPlaying": {
          "type": "boolean",
          "required": true,
          "description": "게임 진행 중 여부"
        },
        "onSwing": {
          "type": "function",
          "required": true,
          "description": "사용자가 화면을 탭할 때 호출되는 배팅 핸들러"
        },
        "ballPosition": {
          "type": "{ x: number; y: number }",
          "required": false,
          "description": "현재 공의 화면 내 위치(퍼센트 기준)"
        },
        "hitResult": {
          "type": "'homerun' | 'triple' | 'double' | 'single' | 'strike' | null",
          "required": false,
          "description": "최근 타격 결과 (판정 애니메이션용)"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "relative flex-1 w-full overflow-hidden cursor-pointer touch-none"
      },
      "children": [
        "FieldBackground",
        "PitchingZone",
        "BattingZone",
        "Ball",
        "HitResultBadge",
        "SwingEffect",
        "TimingBar"
      ],
      "states": ["idle", "pitching", "swing", "hit", "miss"],
      "accessibility": {
        "role": "button",
        "ariaLabel": "배팅 영역 - 탭하여 스윙",
        "ariaPressed": "false"
      }
    },
    {
      "name": "FieldBackground",
      "type": "atom",
      "description": "야구장 느낌의 그라디언트 배경 및 다이아몬드 마킹 SVG 오버레이.",
      "props": {},
      "layout": {
        "display": "block",
        "tailwind": "absolute inset-0 bg-gradient-to-b from-sky-900 via-green-900 to-green-950"
      },
      "children": [
        {
          "element": "div",
          "note": "다이아몬드 그라운드 마킹 (원근감 적용)",
          "tailwind": "absolute bottom-0 left-1/2 -translate-x-1/2 w-64 h-48 border-2 border-white/10 rotate-45 origin-bottom"
        },
        {
          "element": "div",
          "note": "마운드 원형 표시",
          "tailwind": "absolute top-1/3 left-1/2 -translate-x-1/2 w-12 h-12 rounded-full border border-white/20 bg-yellow-900/30"
        }
      ],
      "states": ["default"],
      "accessibility": {
        "ariaHidden": "true"
      }
    },
    {
      "name": "Ball",
      "type": "atom",
      "description": "투수에서 타자 방향으로 날아오는 야구공. 원근감을 표현하기 위해 시작 시 작고 타석에 가까워질수록 커지는 CSS 트랜지션 애니메이션 적용.",
      "props": {
        "size": {
          "type": "number",
          "required": true,
          "description": "현재 공 크기(px) — 애니메이션으로 제어"
        },
        "positionX": {
          "type": "number",
          "required": true,
          "description": "공의 X 위치 (%) "
        },
        "positionY": {
          "type": "number",
          "required": true,
          "description": "공의 Y 위치 (%)"
        },
        "isVisible": {
          "type": "boolean",
          "required": true,
          "description": "공 표시 여부"
        }
      },
      "layout": {
        "display": "block",
        "tailwind": "absolute rounded-full bg-white shadow-lg shadow-white/40 transition-all duration-100 ease-linear pointer-events-none"
      },
      "children": [
        {
          "element": "span",
          "note": "야구공 실밥 라인 (SVG 또는 border 트릭)",
          "tailwind": "block w-full h-full rounded-full border border-red-400/60"
        }
      ],
      "states": ["flying", "hidden"],
      "accessibility": {
        "ariaHidden": "true"
      }
    },
    {
      "name": "TimingBar",
      "type": "molecule",
      "description": "화면 하단에 배치되는 리듬 타이밍 게이지. 중앙의 완벽 타이밍 존(황금색)과 허용 존(초록색)을 포함하여 사용자가 언제 탭해야 하는지 시각적으로 안내.",
      "props": {
        "markerPosition": {
          "type": "number",
          "required": true,
          "description": "좌우로 이동하는 타이밍 마커의 현재 위치 (0~100%)"
        },
        "isActive": {
          "type": "boolean",
          "required": true,
          "description": "타이밍 바 활성화 여부"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "absolute bottom-24 left-4 right-4 h-6 rounded-full bg-gray-800/80 overflow-hidden border border-gray-600"
      },
      "children": [
        {
          "element": "div",
          "note": "허용 타이밍 존 (좌측 그린)",
          "tailwind": "absolute left-[30%] w-[20%] h-full bg-green-500/40"
        },
        {
          "element": "div",
          "note": "완벽 타이밍 존 (중앙 황금)",
          "tailwind": "absolute left-[42%] w-[16%] h-full bg-yellow-400/70"
        },
        {
          "element": "div",
          "note": "허용 타이밍 존 (우측 그린)",
          "tailwind": "absolute left-[50%] w-[20%] h-full bg-green-500/40"
        },
        {
          "element": "div",
          "note": "이동하는 타이밍 마커",
          "tailwind": "absolute top-0 h-full w-1.5 rounded-full bg-white shadow-md shadow-white/60 transition-none"
        }
      ],
      "states": ["active", "inactive", "hit", "miss"],
      "accessibility": {
        "role": "progressbar",
        "ariaLabel": "타이밍 게이지",
        "ariaValueMin": "0",
        "ariaValueMax": "100"
      }
    },
    {
      "name": "BattingZone",
      "type": "atom",
      "description": "타자 위치를 나타내는 반투명 홈플레이트 마킹. 화면 하단 중앙에 고정 표시.",
      "props": {},
      "layout": {
        "display": "flex",
        "tailwind": "absolute bottom-8 left-1/2 -translate-x-1/2 w-16 h-10 pointer-events-none"
      },
      "children": [
        {
          "element": "div",
          "note": "홈플레이트 오각형 (clip-path 활용)",
          "tailwind": "w-full h-full bg-white/20 border-2 border-white/40 rounded-sm"
        }
      ],
      "states": ["default", "active"],
      "accessibility": {
        "ariaHidden": "true"
      }
    },
    {
      "name": "HitResultBadge",
      "type": "atom",
      "description": "타격 결과를 화면 중앙에 크게 표시하는 플로팅 배지. 결과에 따라 색상과 텍스트가 달라지고, 등장 후 자동으로 사라지는 애니메이션 포함.",
      "props": {
        "result": {
          "type": "'homerun' | 'triple' | 'double' | 'single' | 'strike' | null",
          "required": true,
          "description": "표시할 타격 결과"
        },
        "isVisible": {
          "type": "boolean",
          "required": true,
          "description": "배지 표시 여부"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "absolute inset-0 flex items-center justify-center pointer-events-none z-20"
      },
      "children": [
        {
          "element": "span",
          "note": "결과 텍스트 — result 값에 따라 tailwind 클래스 동적 변경",
          "variants": {
            "homerun": {
              "tailwind": "text-6xl font-black text-yellow-400 drop-shadow-[0_0_20px_rgba(250,204,21,0.9)] animate-bounce",
              "text": "HOME RUN!"
            },
            "triple": {
              "tailwind": "text-5xl font-black text-cyan-300 drop-shadow-[0_0_16px_rgba(103,232,249,0.8)]",
              "text": "3루타!"
            },
            "double": {
              "tailwind": "text-5xl font-black text-green-400 drop-shadow-[0_0_16px_rgba(74,222,128,0.8)]",
              "text": "2루타!"
            },
            "single": {
              "tailwind": "text-5xl font-black text-blue-300 drop-shadow-[0_0_16px_rgba(147,197,253,0.8)]",
              "text": "1루타!"
            },
            "strike": {
              "tailwind": "text-5xl font-black text-red-500 drop-shadow-[0_0_16px_rgba(239,68,68,0.8)]",
              "text": "STRIKE"
            }
          }
        }
      ],
      "states": ["visible", "hidden"],
      "accessibility": {
        "role": "alert",
        "ariaLive": "assertive",
        "ariaAtomic": "true"
      }
    },
    {
      "name": "SwingEffect",
      "type": "atom",
      "description": "사용자가 탭하는 순간 배트 스윙 이펙트(호 모양 잔상)를 표시하는 순간적인 오버레이.",
      "props": {
        "isActive": {
          "type": "boolean",
          "required": true,
          "description": "스윙 이펙트 활성 여부"
        }
      },
      "layout": {
        "display": "block",
        "tailwind": "absolute bottom-10 left-1/2 -translate-x-1/2 w-40 h-40 pointer-events-none z-10"
      },
      "children": [
        {
          "element": "div",
          "note": "반원 호 모양 스윙 이펙트",
          "tailwind": "w-full h-full rounded-full border-4 border-white/60 border-b-transparent rotate-[-30deg] opacity-0 data-[active=true]:opacity-100 data-[active=true]:animate-ping"
        }
      ],
      "states": ["idle", "swinging"],
      "accessibility": {
        "ariaHidden": "true"
      }
    },
    {
      "name": "GameHUD",
      "type": "organism",
      "description": "화면 하단의 게임 컨트롤 영역. 게임 시작 전에는 시작 버튼을, 게임 중에는 일시정지 버튼을 표시. 타석 순서(이닝 진행 현황)도 포함.",
      "props": {
        "gameState": {
          "type": "'idle' | 'playing' | 'paused'",
          "required": true,
          "description": "현재 게임 상태"
        },
        "onStart": {
          "type": "function",
          "required": true,
          "description": "게임 시작 핸들러"
        },
        "onPause": {
          "type": "function",
          "required": true,
          "description": "일시정지/재개 핸들러"
        },
        "basesOccupied": {
          "type": "{ first: boolean; second: boolean; third: boolean }",
          "required": true,
          "description": "현재 베이스 점유 상태"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex items-center justify-between w-full px-6 py-4 bg-gray-900/90 backdrop-blur-sm border-t border-gray-700"
      },
      "children": [
        "DiamondBaseMap",
        "StartPauseButton"
      ],
      "states": ["idle", "playing", "paused"],
      "accessibility": {
        "role": "toolbar",
        "ariaLabel": "게임 컨트롤"
      }
    },
    {
      "name": "DiamondBaseMap",
      "type": "molecule",
      "description": "미니어처 다이아몬드 베이스 맵. 주자가 있는 베이스를 밝은 색으로 하이라이트하여 현재 주루 현황을 표시.",
      "props": {
        "basesOccupied": {
          "type": "{ first: boolean; second: boolean; third: boolean }",
          "required": true,
          "description": "각 베이스 점유 여부"
        }
      },
      "layout": {
        "display": "grid",
        "tailwind": "relative w-16 h-16"
      },
      "children": [
        {
          "element": "div",
          "note": "2루 (상단 중앙)",
          "tailwind": "absolute top-0 left-1/2 -translate-x-1/2 w-4 h-4 rotate-45 border-2 border-white/60 data-[occupied=true]:bg-yellow-400 data-[occupied=false]:bg-transparent"
        },
        {
          "element": "div",
          "note": "3루 (좌측 중앙)",
          "tailwind": "absolute top-1/2 left-0 -translate-y-1/2 w-4 h-4 rotate-45 border-2 border-white/60 data-[occupied=true]:bg-yellow-400 data-[occupied=false]:bg-transparent"
        },
        {
          "element": "div",
          "note": "1루 (우측 중앙)",
          "tailwind": "absolute top-1/2 right-0 -translate-y-1/2 w-4 h-4 rotate-45 border-2 border-white/60 data-[occupied=true]:bg-yellow-400 data-[occupied=false]:bg-transparent"
        },
        {
          "element": "div",
          "note": "홈플레이트 (하단 중앙)",
          "tailwind": "absolute bottom-0 left-1/2 -translate-x-1/2 w-4 h-4 rotate-45 bg-white/80"
        }
      ],
      "states": ["default"],
      "accessibility": {
        "role": "img",
        "ariaLabel": "베이스 점유 현황 다이아몬드"
      }
    },
    {
      "name": "StartPauseButton",
      "type": "atom",
      "description": "게임 시작 / 일시정지 / 재개를 제어하는 원형 버튼.",
