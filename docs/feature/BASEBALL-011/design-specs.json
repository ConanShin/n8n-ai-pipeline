  "typography": {
    "bigScore":        "text-4xl sm:text-5xl font-black tabular-nums text-white",
    "inningScore":     "text-sm font-bold tabular-nums",
    "totalScore":      "text-lg font-black tabular-nums",
    "teamName":        "text-sm font-bold text-gray-100 truncate",
    "headerLabel":     "text-xs font-semibold uppercase tracking-wider text-gray-500",
    "statusBadge":     "text-xs font-extrabold tracking-widest uppercase",
    "statValue":       "text-sm font-bold tabular-nums",
    "legendText":      "text-xs text-gray-400",
    "pageTitle":       "text-lg sm:text-xl font-extrabold text-white",
    "meta":            "text-xs text-gray-600"
  },
  "breakpoints": {
    "strategy": "mobile-first",
    "base":  "< 640px  — 팀 단축명, 셀 축소(w-8 h-9), 아바타 sm, 빅스코어 text-4xl",
    "sm":    "≥ 640px  — 팀 전체명, 셀 확대(w-10 h-10), 아바타 md/lg, 빅스코어 text-5xl, 여백 확대",
    "md":    "≥ 768px  — 최대 너비(max-w-3xl) 중앙 고정, 전체 이닝 행 여유 있게 표시",
    "lg":    "≥ 1024px — 이닝 헤더/셀 폰트 크기 유지, 카드 패딩 확대"
  },
  "interactions": [
    {
      "trigger": "mount",
      "element": "ScoreboardPage",
      "action": "gameId 기반 경기 데이터 API 호출 → pageState를 'loading'으로 설정. 응답 수신 시 gameStatus에 따라 페이지 상태 전환"
    },
    {
      "trigger": "poll (interval)",
      "element": "ScoreboardPage — 실시간 업데이트",
      "action": "gameStatus가 'live'인 경우 30초 간격으로 데이터 재조회. 새 이닝 점수 또는 통계 변경 시 관련 셀 값 갱신"
    },
    {
      "trigger": "data-change",
      "element": "InningCell (currentInning 변경)",
      "action": "이전 이닝 셀의 노란 하이라이트 제거, 새 currentInning 셀에 bg-yellow-400 + ring-2 + shadow 적용 (transition-colors 200ms)"
    },
    {
      "trigger": "data-change",
      "element": "GameStatusBadge",
      "action": "gameStatus가 'live' → 'final'로 바뀌면 배지가 빨간 LIVE → 노란 FINAL로 전환. ariaLive='polite'로 스크린리더 알림"
    },
    {
      "trigger": "data-change",
      "element": "TotalScoreCell / StatCell",
      "action": "점수나 통계 수치 변경 시 짧은 scale-up + 색상 flash 트랜지션으로 변경 강조 (300ms)"
    },
    {
      "trigger": "hover",
      "element": "InningScoreRow",
      "action": "행 전체에 bg-gray-800/30 hover 배경 적용 (transition-colors 150ms)"
    },
    {
      "trigger": "scroll (horizontal)",
      "element": "ScoreboardTable — overflow-x-auto 컨테이너",
      "action": "이닝 수가 많아 테이블이 넘칠 경우 가로 스크롤. TeamInfoRow는 sticky left-0로 고정하여 팀명 항상 표시"
    },
    {
      "trigger": "click",
      "element": "ScoreboardPage — 뒤로가기 버튼",
      "action": "경기 목록 페이지 또는 직전 라우트로 네비게이션"
    },
    {
      "trigger": "click",
      "element": "ScoreboardPage — 에러 상태 재시도 버튼",
      "action": "pageState를 'loading'으로 리셋 후 데이터 API 재호출"
    },
    {
      "trigger": "resize",
      "element": "ScoreboardTemplate 전체",
      "action": "뷰포트 변경에 따라 Tailwind 반응형 클래스 적용: 모바일↔태블릿↔데스크톱 레이아웃 자동 전환"
    }
  ],
  "animationGuidelines": {
    "currentInningHighlight":  "transition-colors duration-200 ease-in-out — isCurrent 변경 시 셀 배경/텍스트 색상 전환",
    "scoreUpdate":             "scale 1 → 1.15 → 1 + color flash, 300ms ease-out — 점수/통계 수치 변경 시",
    "statusBadgeChange":       "opacity 0 → 1, 200ms ease-in — 배지 상태 전환 시",
    "liveBadgePulse":          "animate-pulse (Tailwind 기본) — live 상태 배지 지속 점멸",
    "rowHover":                "transition-colors duration-150 ease-in-out — 행 hover 배경",
    "pageLoadSkeleton":        "animate-pulse on 스켈레톤 오버레이 — 데이터 로딩 중 시각 피드백"
  },
  "dataModel": {
    "note": "UI 명세 참고용 — 백엔드 API 스펙 아님",
    "GameData": {
      "gameId":        "string",
      "gameStatus":    "'scheduled' | 'live' | 'final'",
      "currentInning": "number (1~12)",
      "inningHalf":    "'top' | 'bottom'",
      "gameDate":      "string (YYYY.MM.DD)",
      "venue":         "string",
      "broadcastChannel": "string | null",
      "lastUpdated":   "string (HH:mm 기준)",
