{
  "ticket": "BASEBALL-011",
  "title": "웹 기반 야구 타이밍 배팅 게임",
  "description": "날아오는 공의 타이밍에 맞춰 화면을 탭/클릭해 배트를 휘두르는 리듬형 야구 게임. 결과는 홈런·3루타·2루타·1루타·스트라이크로 판정되고, 기회는 3번(아웃 3회)이다.",
  "atomicDesignOverview": {
    "atoms": [
      "PitchBall",
      "SwingResultLabel",
      "StrikeIndicator",
      "ScoreBadge",
      "CountdownTimer",
      "TapButton",
      "HitZoneBar"
    ],
    "molecules": [
      "StrikeCounter",
      "ScoreDisplay",
      "ResultOverlay",
      "PitchLane",
      "GameControlBar"
    ],
    "organisms": [
      "BattingField",
      "GameHUD",
      "GameOverPanel",
      "ReadyCountdown"
    ],
    "templates": [
      "GameTemplate"
    ],
    "pages": [
      "BaseballGamePage"
    ]
  },
  "components": [
    {
      "name": "PitchBall",
      "type": "atom",
      "description": "투수가 던진 공을 나타내는 원형 요소. 화면 우측(또는 상단)에서 타자 위치까지 CSS 애니메이션으로 이동. 공의 속도와 타이밍 윈도우 크기를 prop으로 받아 애니메이션 duration을 조절함",
      "props": {
        "speedMs": {
          "type": "number",
          "required": true,
          "description": "공이 타자에게 도달하기까지 걸리는 시간(ms). 예: 1200 — 구속에 따라 달라짐"
        },
        "isActive": {
          "type": "boolean",
          "required": true,
          "description": "공이 현재 날아오는 중인지 여부. false면 숨김 처리"
        },
        "hitQuality": {
          "type": "string",
          "required": false,
          "description": "'perfect' | 'good' | 'miss' | null — 판정 후 공 색상/효과 변경용"
        }
      },
      "layout": {
        "display": "block",
        "tailwind": "absolute w-10 h-10 sm:w-12 sm:h-12 rounded-full shadow-xl pointer-events-none select-none flex items-center justify-center"
      },
      "variants": {
        "default":  { "tailwind": "bg-white border-4 border-gray-200 shadow-white/30" },
        "perfect":  { "tailwind": "bg-yellow-300 border-4 border-yellow-400 shadow-yellow-300/60 scale-125" },
        "good":     { "tailwind": "bg-green-300 border-4 border-green-400 shadow-green-300/40" },
        "miss":     { "tailwind": "bg-gray-400 border-4 border-gray-500 opacity-40" }
      },
      "animation": {
        "keyframe": "translateX from right edge → bat contact point",
        "duration": "{speedMs}ms",
        "easing": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
        "onHit":   "scale-150 + opacity-0, 200ms ease-out",
        "onMiss":  "continue translate past screen, opacity fade 300ms"
      },
      "states": ["idle", "flying", "hit-perfect", "hit-good", "missed"],
      "accessibility": {
        "role": "img",
        "ariaLabel": "날아오는 야구공",
        "ariaHidden": "true"
      }
    },
    {
      "name": "SwingResultLabel",
      "type": "atom",
      "description": "스윙 판정 결과를 화면 중앙에 크게 팝업으로 표시하는 텍스트 라벨. 홈런/안타/스트라이크 등 결과에 따라 색상·크기 변형. 표시 후 자동 페이드아웃",
      "props": {
        "result": {
          "type": "string",
          "required": true,
          "description": "'homerun' | 'triple' | 'double' | 'single' | 'strike'"
        },
        "visible": {
          "type": "boolean",
          "required": true,
          "description": "라벨 표시 여부. false면 opacity-0 처리"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "absolute inset-0 items-center justify-center pointer-events-none z-30 select-none"
      },
      "variants": {
        "homerun": {
          "tailwind": "text-yellow-300 text-5xl sm:text-7xl font-black tracking-tight drop-shadow-[0_0_20px_rgba(253,224,71,0.9)]",
          "label": "🏆 홈런!",
          "animation": "scale-0 → scale-110 → scale-100, 250ms spring; fade-out 800ms"
        },
        "triple": {
          "tailwind": "text-orange-400 text-4xl sm:text-6xl font-black tracking-tight drop-shadow-lg",
          "label": "🔥 3루타!",
          "animation": "scale-0 → scale-100, 200ms; fade-out 700ms"
        },
        "double": {
          "tailwind": "text-green-400 text-4xl sm:text-5xl font-black tracking-tight drop-shadow-lg",
          "label": "⚡ 2루타!",
          "animation": "scale-0 → scale-100, 200ms; fade-out 700ms"
        },
        "single": {
          "tailwind": "text-blue-300 text-3xl sm:text-4xl font-black tracking-tight drop-shadow",
          "label": "✅ 1루타!",
          "animation": "scale-0 → scale-100, 180ms; fade-out 600ms"
        },
        "strike": {
          "tailwind": "text-red-400 text-3xl sm:text-4xl font-black tracking-tight drop-shadow",
          "label": "✕ 스트라이크",
          "animation": "shake-x 300ms; fade-out 500ms"
        }
      },
      "states": ["hidden", "homerun", "triple", "double", "single", "strike"],
      "accessibility": {
        "role": "alert",
        "ariaLive": "assertive",
        "ariaLabel": "스윙 판정: {result}"
      }
    },
    {
      "name": "StrikeIndicator",
      "type": "atom",
      "description": "개별 스트라이크(기회) 1개를 원형 아이콘으로 표시. 사용된 기회는 채워진 빨간 원, 남은 기회는 빈 회색 원으로 표시",
      "props": {
        "used": {
          "type": "boolean",
          "required": true,
          "description": "해당 기회를 이미 사용했는지 여부"
        },
        "index": {
          "type": "number",
          "required": true,
          "description": "기회 순번 (0, 1, 2)"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "w-5 h-5 sm:w-6 sm:h-6 rounded-full border-2 items-center justify-center transition-all duration-300"
      },
      "variants": {
        "remaining": { "tailwind": "border-gray-600 bg-transparent" },
        "used":      { "tailwind": "border-red-500 bg-red-500 shadow-red-500/50 shadow-md scale-110" }
      },
      "states": ["remaining", "used"],
      "accessibility": {
        "role": "img",
        "ariaLabel": "{used ? '사용된 기회' : '남은 기회'} {index + 1}번째"
      }
    },
    {
      "name": "ScoreBadge",
      "type": "atom",
      "description": "현재 누적 점수를 크게 표시하는 배지. 점수 변경 시 scale 애니메이션으로 강조",
      "props": {
        "score": {
          "type": "number",
          "required": true,
          "description": "현재 누적 점수"
        },
        "animated": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "점수 변경 직후 팝 애니메이션 트리거"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex-col items-center gap-0.5"
      },
      "children": [
        {
          "element": "span",
          "tailwind": "text-xs font-semibold uppercase tracking-widest text-gray-400",
          "content": "SCORE"
        },
        {
          "element": "span",
          "tailwind": "text-4xl sm:text-5xl font-black tabular-nums text-white transition-transform duration-200",
          "animatedClass": "scale-125 text-yellow-300",
          "content": "{score}"
        }
      ],
      "states": ["default", "updated"],
      "accessibility": {
        "role": "status",
        "ariaLive": "polite",
        "ariaLabel": "현재 점수 {score}점"
      }
    },
    {
      "name": "CountdownTimer",
      "type": "atom",
      "description": "게임 시작 전 3·2·1·GO! 카운트다운 숫자를 중앙에 크게 표시하는 타이머 원소. 각 숫자는 scale-in → scale-out 애니메이션으로 순차 표시",
      "props": {
        "count": {
          "type": "number | string",
          "required": true,
          "description": "표시할 카운트 값. 예: 3, 2, 1, 'GO!'"
        },
        "visible": {
          "type": "boolean",
          "required": true,
          "description": "현재 표시 여부"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "absolute inset-0 items-center justify-center z-40 pointer-events-none"
      },
      "children": [
        {
          "element": "span",
          "tailwind": "text-8xl sm:text-9xl font-black text-white drop-shadow-[0_0_40px_rgba(255,255,255,0.6)] select-none",
          "animation": "scale-0 → scale-100 → scale-150 + opacity-0, 900ms ease-in-out",
          "content": "{count}"
        }
      ],
      "states": ["hidden", "counting", "go"],
      "accessibility": {
        "role": "timer",
        "ariaLive": "assertive",
        "ariaLabel": "게임 시작까지 {count}"
      }
    },
    {
      "name": "TapButton",
      "type": "atom",
      "description": "플레이어가 배트를 휘두르기 위해 탭/클릭하는 메인 인터랙션 버튼. 화면 하단 중앙에 위치하는 대형 원형 버튼. 누르는 순간 시각적 피드백 제공",
      "props": {
        "disabled": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "비활성화 여부 (게임 중이 아닐 때, 결과 표시 중 등)"
        },
        "onTap": {
          "type": "function",
          "required": true,
          "description": "탭/클릭 이벤트 핸들러"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "relative w-36 h-36 sm:w-44 sm:h-44 rounded-full items-center justify-center cursor-pointer select-none touch-none"
      },
      "variants": {
        "default":  {
          "tailwind": "bg-gradient-to-br from-amber-400 to-orange-500 shadow-2xl shadow-orange-500/50 border-4 border-amber-300 active:scale-95 transition-transform duration-75",
          "innerLabel": { "tailwind": "text-white text-2xl sm:text-3xl font-black tracking-tight drop-shadow", "content": "⚾ HIT!" }
        },
        "pressed":  {
          "tailwind": "scale-90 bg-gradient-to-br from-amber-300 to-orange-400 shadow-md shadow-orange-400/30",
          "ripple": "absolute inset-0 rounded-full bg-white/30 animate-ping"
        },
        "disabled": {
          "tailwind": "bg-gray-700 border-gray-600 opacity-50 cursor-not-allowed shadow-none"
        }
      },
      "states": ["default", "pressed", "disabled"],
      "accessibility": {
        "role": "button",
        "ariaLabel": "배트 휘두르기 — 탭하여 공을 치세요",
        "ariaDisabled": "{disabled}"
      }
    },
    {
      "name": "HitZoneBar",
      "type": "atom",
      "description": "타이밍 판정 기준을 시각화하는 진행 바. 공의 위치에 따라 현재 판정 가능 구간을 색상 레이어로 표시. Perfect(노란색) / Good(초록색) / 판정 불가(회색) 구간을 겹쳐서 표시",
      "props": {
        "ballProgress": {
          "type": "number",
          "required": true,
          "description": "공의 현재 이동 진행도 (0.0 ~ 1.0)"
        },
        "perfectWindow": {
          "type": "object",
          "required": true,
          "description": "{ start: number, end: number } — Perfect 판정 진행도 범위 (0~1)"
        },
        "goodWindow": {
          "type": "object",
          "required": true,
          "description": "{ start: number, end: number } — Good 판정 진행도 범위 (0~1)"
        },
        "visible": {
          "type": "boolean",
          "required": false,
          "default": true,
          "description": "바 표시 여부 (연습 모드에서만 표시 등 설정 가능)"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "relative w-full h-3 sm:h-4 rounded-full overflow-hidden bg-gray-800"
      },
      "children": [
        {
          "element": "div",
          "tailwind": "absolute h-full bg-green-500/40 rounded-full transition-all duration-75",
          "description": "Good 구간 레이어 (너비/left는 goodWindow 기반 계산)"
        },
        {
          "element": "div",
          "tailwind": "absolute h-full bg-yellow-400/70 rounded-full transition-all duration-75",
          "description": "Perfect 구간 레이어 (너비/left는 perfectWindow 기반 계산)"
        },
        {
          "element": "div",
          "tailwind": "absolute top-0 bottom-0 w-1 bg-white rounded-full shadow-white/80 shadow-md transition-all duration-75",
          "description": "공 현재 위치 마커 (left는 ballProgress 기반 계산)"
        }
      ],
      "states": ["idle", "flying", "hit", "missed"],
      "accessibility": {
        "role": "progressbar",
        "ariaLabel": "공 타이밍 게이지",
        "ariaValuenow": "{Math.round(ballProgress * 100)}",
        "ariaValuemin": "0",
        "ariaValuemax": "100"
      }
    },
    {
      "name": "StrikeCounter",
      "type": "molecule",
      "description": "현재 아웃/스트라이크 횟수를 StrikeIndicator 3개로 표시하는 기회 카운터. 제목 라벨 포함",
      "props": {
        "usedCount": {
          "type": "number",
          "required": true,
          "description": "현재까지 사용한 스트라이크/아웃 횟수 (0~3)"
        },
        "maxCount": {
          "type": "number",
          "required": false,
          "default": 3,
          "description": "최대 기회 수 (기본 3)"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex-col items-center gap-1.5"
      },
      "children": [
        {
          "element": "span",
          "tailwind": "text-xs font-semibold uppercase tracking-widest text-gray-400",
          "content": "STRIKES"
        },
        {
          "element": "div",
          "tailwind": "flex items-center gap-2",
          "description": "StrikeIndicator × 3",
          "children": [
            { "name": "StrikeIndicator", "type": "atom", "repeat": 3 }
          ]
        }
      ],
      "states": ["default", "last-chance", "game-over"],
      "variants": {
        "last-chance": {
          "description": "usedCount === 2일 때 마지막 기회 경고",
          "titleTailwind": "text-red-400 animate-pulse"
        }
      },
      "accessibility": {
        "role": "status",
        "ariaLabel": "남은 기회 {maxCount - usedCount}번"
      }
    },
    {
      "name": "ScoreDisplay",
      "type": "molecule",
      "description": "점수(ScoreBadge) + 최고 기록 라벨을 묶은 점수 표시 영역",
      "props": {
        "score": {
          "type": "number",
          "required": true,
          "description": "현재 누적 점수"
        },
        "bestScore": {
          "type": "number",
          "required": false,
          "description": "이번 세션 최고 점수. 없으면 미표시"
        },
        "scoreUpdated": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "점수 갱신 직후 애니메이션 트리거"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex-col items-center gap-1"
      },
      "children": [
        { "name": "ScoreBadge", "type": "atom" },
        {
          "element": "span",
          "tailwind": "text-xs text-gray-600 tabular-nums",
          "content": "BEST {bestScore}",
          "visibleWhen": "bestScore !== undefined"
        }
      ],
      "states": ["default", "updated", "new-record"],
      "accessibility": {
        "role": "region",
        "ariaLabel": "점수 현황"
      }
    },
    {
      "name": "ResultOverlay",
      "type": "molecule",
      "description": "타이밍 판정 직후 화면 중앙에 잠깐 표시되는 결과 팝업. SwingResultLabel + 타이밍 품질 서브텍스트(Perfect! / Good / Too Early / Too Late) 조합",
      "props": {
        "result": {
          "type": "string",
          "required": true,
          "description": "'homerun' | 'triple' | 'double' | 'single' | 'strike'"
        },
        "timing": {
          "type": "string",
          "required": false,
          "description": "'perfect' | 'good' | 'early' | 'late' | null — 세부 타이밍 피드백"
        },
        "visible": {
          "type": "boolean",
          "required": true,
          "description": "표시 여부"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "absolute inset-0 flex-col items-center justify-center gap-3 z-30 pointer-events-none"
      },
      "children": [
        { "name": "SwingResultLabel", "type": "atom" },
        {
          "element": "span",
          "tailwind": "text-base sm:text-lg font-bold text-white/80 tracking-wide drop-shadow",
          "content": "{timing === 'perfect' ? '🎯 Perfect Timing!' : timing === 'good' ? '👍 Good!' : timing === 'early' ? '⬅ Too Early' : timing === 'late' ? '➡ Too Late' : ''}",
          "visibleWhen": "!!timing && result === 'strike'"
        }
      ],
      "states": ["hidden", "show-hit", "show-strike"],
      "accessibility": {
        "role": "alert",
        "ariaLive": "assertive",
        "ariaLabel": "판정 결과: {result}"
      }
    },
    {
      "name": "PitchLane",
      "type": "molecule",
      "description": "공이 날아오는 경로 레인. 배경에 궤적 가이드라인을 반투명으로 표시하고, PitchBall이 그 위를 가로질러 이동. HitZoneBar가 하단에 위치",
      "props": {
        "ballSpeedMs": {
          "type": "number",
          "required": true,
          "description": "현재 공 속도(ms)"
        },
        "isActive": {
          "type": "boolean",
          "required": true,
          "description": "투구 진행 중 여부"
        },
        "ballProgress": {
          "type": "number",
          "required": true,
          "description": "공 이동 진행도 (0.0 ~ 1.0)"
        },
        "hitQuality": {
          "type": "string",
          "required": false,
          "description": "판정 결과: 'perfect' | 'good' | 'miss' | null"
        },
        "perfectWindow": {
          "type": "object",
          "required": true,
          "description": "{ start, end } Perfect 판정 구간"
        },
        "goodWindow": {
          "type": "object",
          "required": true,
          "description": "{ start, end } Good 판정 구간"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "relative w-full flex-1 flex flex-col overflow-hidden"
      },
      "children": [
        {
          "element": "div",
          "tailwind": "absolute inset-0 flex items-center",
          "description": "투구 경로 배경 가이드라인",
          "children": [
            {
              "element": "div",
              "tailwind": "w-full h-px bg-gradient-to-r from-transparent via-gray-600/40 to-transparent"
            }
          ]
        },
        {
          "element": "div",
          "tailwind": "absolute top-1/2 -translate-y-1/2 right-8 sm:right-12",
          "description": "타자(배트) 실루엣 아이콘 — 고정 위치",
          "children": [
            {
              "element": "span",
              "tailwind": "text-4xl sm:text-5xl select-none",
              "content": "🏏",
              "accessibility": { "ariaHidden": "true" }
            }
          ]
        },
        { "name": "PitchBall", "type": "atom" },
        {
          "element": "div",
          "tailwind": "absolute bottom-2 left-4 right-4",
          "children": [{ "name": "HitZoneBar", "type": "atom" }]
        }
      ],
      "states": ["idle", "pitching", "hit", "missed"],
      "accessibility": {
        "role": "region",
        "ariaLabel": "투구 레인"
      }
    },
    {
      "name": "GameControlBar",
      "type": "molecule",
      "description": "게임 상태 제어 버튼(일시정지·재시작·음소거)을 상단에 배치하는 컨트롤 바",
      "props": {
        "isPaused": {
          "type": "boolean",
