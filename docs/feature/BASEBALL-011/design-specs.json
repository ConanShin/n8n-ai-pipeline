{
  "ticket": "BASEBALL-011",
  "title": "야구 경기 스코어보드 컴포넌트",
  "description": "야구 경기의 실시간 스코어보드를 표시하는 React 컴포넌트. 이닝별 점수, 팀 정보, 주요 타격 통계(H/E/BB)를 전통적인 다크 스타일로 제공하며, 현재 이닝 하이라이트와 경기 상태 배지를 포함한다.",
  "atomicDesignOverview": {
    "atoms": [
      "TeamAvatar",
      "InningCell",
      "StatCell",
      "GameStatusBadge",
      "TotalScoreCell",
      "SectionLabel"
    ],
    "molecules": [
      "TeamInfoRow",
      "InningScoreRow",
      "StatSummaryRow",
      "InningHeaderRow",
      "ScoreboardLegend"
    ],
    "organisms": [
      "ScoreboardTable",
      "ScoreboardHeader",
      "ScoreboardFooter"
    ],
    "templates": [
      "ScoreboardTemplate"
    ],
    "pages": [
      "ScoreboardPage"
    ]
  },
  "components": [
    {
      "name": "TeamAvatar",
      "type": "atom",
      "description": "팀 로고 이미지가 없을 때 이니셜(2자)을 원형 배경으로 표시하는 아바타. 팀 고유 색상을 배경으로 사용",
      "props": {
        "initials": {
          "type": "string",
          "required": true,
          "description": "팀 이니셜 (예: 'KT', 'LG', 'SS')"
        },
        "teamColor": {
          "type": "string",
          "required": false,
          "default": "#374151",
          "description": "팀 배경 색상 (HEX 또는 Tailwind 색상 토큰)"
        },
        "size": {
          "type": "string",
          "required": false,
          "default": "md",
          "description": "'sm' | 'md' | 'lg' — 아바타 크기"
        },
        "logoSrc": {
          "type": "string",
          "required": false,
          "description": "팀 로고 이미지 URL. 제공 시 이미지 우선 렌더링, 없으면 이니셜 폴백"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "items-center justify-center rounded-full font-extrabold tracking-tight select-none shrink-0 overflow-hidden"
      },
      "sizeMap": {
        "sm": "w-7 h-7 text-xs",
        "md": "w-10 h-10 text-sm",
        "lg": "w-14 h-14 text-xl"
      },
      "states": ["default", "image-loaded", "image-fallback"],
      "accessibility": {
        "role": "img",
        "ariaLabel": "{initials} 팀 로고"
      }
    },
    {
      "name": "InningCell",
      "type": "atom",
      "description": "스코어보드 테이블에서 이닝 한 칸의 점수를 표시하는 셀. 현재 이닝이면 노란색 하이라이트, 아직 플레이되지 않은 이닝이면 대시(-) 표시",
      "props": {
        "score": {
          "type": "number | null",
          "required": true,
          "description": "해당 이닝 점수. null이면 미진행 이닝으로 '-' 표시"
        },
        "isCurrent": {
          "type": "boolean",
          "required": true,
          "description": "현재 진행 중인 이닝 여부. true이면 노란색 하이라이트 적용"
        },
        "isHeader": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "이닝 번호 헤더 셀 여부 (숫자만 표시, 점수 스타일 없음)"
        },
        "inningNumber": {
          "type": "number",
          "required": false,
          "description": "이닝 번호 (헤더 셀일 때 사용, 1~12)"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "items-center justify-center w-8 h-9 sm:w-10 sm:h-10 text-sm font-bold tabular-nums transition-colors duration-200 shrink-0"
      },
      "variants": {
        "default":      { "tailwind": "bg-transparent text-gray-200" },
        "current":      { "tailwind": "bg-yellow-400 text-gray-900 rounded font-extrabold ring-2 ring-yellow-300 shadow-yellow-400/50 shadow-md" },
        "empty":        { "tailwind": "bg-transparent text-gray-600" },
        "header":       { "tailwind": "bg-transparent text-gray-500 text-xs font-semibold uppercase" }
      },
      "states": ["default", "current", "empty", "header"],
      "accessibility": {
        "role": "cell",
        "ariaLabel": "{isHeader ? `${inningNumber}회` : isCurrent ? `현재 ${inningNumber}회 ${score ?? '진행 중'}점` : `${inningNumber}회 ${score ?? '미진행'}점`}"
      }
    },
    {
      "name": "StatCell",
      "type": "atom",
      "description": "H(안타), E(에러), BB(볼넷) 등 경기 통계 수치를 표시하는 셀. 헤더 라벨 버전과 수치 버전 두 가지 변형",
      "props": {
        "value": {
          "type": "number | string",
          "required": true,
          "description": "표시할 통계 값 또는 라벨 문자열 (예: 8, 'H', 'E', 'BB')"
        },
        "statType": {
          "type": "string",
          "required": false,
          "description": "'H' | 'E' | 'BB' | 'R' — 통계 유형 (색상 강조 분기용)"
        },
        "isHeader": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "헤더 라벨 셀 여부"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "items-center justify-center w-10 h-9 sm:w-12 sm:h-10 text-sm font-bold tabular-nums shrink-0"
      },
      "variants": {
        "header":  { "tailwind": "text-gray-400 text-xs font-semibold uppercase tracking-wider" },
        "H":       { "tailwind": "text-green-400 font-extrabold" },
        "E":       { "tailwind": "text-red-400 font-extrabold" },
        "BB":      { "tailwind": "text-blue-400 font-extrabold" },
        "R":       { "tailwind": "text-yellow-300 font-extrabold" },
        "default": { "tailwind": "text-gray-200" }
      },
      "states": ["default", "header"],
      "accessibility": {
        "role": "cell",
        "ariaLabel": "{isHeader ? statType + ' 통계 항목' : statType + ' ' + value}"
      }
    },
    {
      "name": "GameStatusBadge",
      "type": "atom",
      "description": "경기 상태(경기 전/진행 중/종료)를 표시하는 배지. 경기 종료 시 'FINAL' 배지로 강조 표시",
      "props": {
        "status": {
          "type": "string",
          "required": true,
          "description": "'scheduled' | 'live' | 'final'"
        },
        "currentInning": {
          "type": "number",
          "required": false,
          "description": "현재 이닝 번호 (status가 'live'일 때 표시)"
        },
        "inningHalf": {
          "type": "string",
          "required": false,
          "description": "'top' | 'bottom' — 이닝 초/말 (live 상태에서 사용)"
        }
      },
      "layout": {
        "display": "inline-flex",
        "tailwind": "items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold tracking-widest uppercase select-none"
      },
      "variants": {
        "scheduled": {
          "tailwind": "bg-gray-700 text-gray-300 border border-gray-600",
          "label": "경기 전",
          "icon": "🕐"
        },
        "live": {
          "tailwind": "bg-red-600 text-white shadow-red-500/50 shadow-md animate-pulse border border-red-400",
          "label": "{inningHalf === 'top' ? '▲' : '▼'} {currentInning}회",
          "icon": "🔴"
        },
        "final": {
          "tailwind": "bg-yellow-400 text-gray-900 shadow-yellow-400/40 shadow-md border border-yellow-300",
          "label": "FINAL",
          "icon": "✅"
        }
      },
      "states": ["scheduled", "live", "final"],
      "accessibility": {
        "role": "status",
        "ariaLive": "polite",
        "ariaLabel": "경기 상태: {status === 'final' ? '경기 종료' : status === 'live' ? `${currentInning}회 ${inningHalf === 'top' ? '초' : '말'} 진행 중` : '경기 전'}"
      }
    },
    {
      "name": "TotalScoreCell",
      "type": "atom",
      "description": "팀별 최종 합산 점수를 크게 강조 표시하는 셀. 이닝 셀과 구분되는 왼쪽 경계선과 더 큰 폰트 사용. 점수가 높은 팀은 추가 강조",
      "props": {
        "score": {
          "type": "number | null",
          "required": true,
          "description": "합산 총 득점. null이면 '-' 표시"
        },
        "isWinning": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "현재 점수 앞선 팀 여부. true이면 노란색 강조"
        },
        "isHeader": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "'R' 헤더 라벨 셀 여부"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "items-center justify-center w-12 h-9 sm:w-14 sm:h-10 text-lg font-black tabular-nums border-l border-gray-600 shrink-0"
      },
      "variants": {
        "default":  { "tailwind": "text-white" },
        "winning":  { "tailwind": "text-yellow-300" },
        "header":   { "tailwind": "text-gray-400 text-xs font-semibold uppercase tracking-wider text-sm" }
      },
      "states": ["default", "winning", "header"],
      "accessibility": {
        "role": "cell",
        "ariaLabel": "{isHeader ? '총 득점' : `합계 ${score ?? 0}점${isWinning ? ' (리드 중)' : ''}`}"
      }
    },
    {
      "name": "SectionLabel",
      "type": "atom",
      "description": "스코어보드 상단 또는 섹션 구분을 위한 텍스트 라벨. 경기 날짜, 구장명 등에 사용",
      "props": {
        "text": {
          "type": "string",
          "required": true,
          "description": "표시할 텍스트"
        },
        "variant": {
          "type": "string",
          "required": false,
          "default": "default",
          "description": "'default' | 'muted' | 'highlight'"
        }
      },
      "layout": {
        "display": "inline-block",
        "tailwind": "text-xs tracking-wider select-none"
      },
      "variants": {
        "default":   { "tailwind": "text-gray-400" },
        "muted":     { "tailwind": "text-gray-600" },
        "highlight": { "tailwind": "text-yellow-400 font-semibold" }
      },
      "states": ["default"],
      "accessibility": {
        "role": "none"
      }
    },
    {
      "name": "TeamInfoRow",
      "type": "molecule",
      "description": "팀 아바타 + 팀 이름을 수평으로 배치한 행. 스코어보드 테이블의 좌측 고정 영역에 위치",
      "props": {
        "teamName": {
          "type": "string",
          "required": true,
          "description": "팀 전체 이름 (예: '키움 히어로즈')"
        },
        "teamShortName": {
          "type": "string",
          "required": true,
          "description": "팀 단축 이름 (예: '키움') — 모바일에서 표시"
        },
        "initials": {
          "type": "string",
          "required": true,
          "description": "아바타용 이니셜 (예: 'KW')"
        },
        "teamColor": {
          "type": "string",
          "required": false,
          "description": "팀 색상 (HEX)"
        },
        "logoSrc": {
          "type": "string",
          "required": false,
          "description": "팀 로고 이미지 URL"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "items-center gap-2 sm:gap-3 min-w-[120px] sm:min-w-[160px] px-2 sm:px-3 h-9 sm:h-10 shrink-0"
      },
      "children": [
        {
          "name": "TeamAvatar",
          "type": "atom",
          "sizeProp": "sm"
        },
        {
          "element": "div",
          "tailwind": "flex flex-col min-w-0",
          "children": [
            {
              "element": "span",
              "tailwind": "hidden sm:block text-sm font-bold text-gray-100 truncate",
              "content": "{teamName}"
            },
            {
              "element": "span",
              "tailwind": "sm:hidden text-sm font-bold text-gray-100 truncate",
              "content": "{teamShortName}"
            }
          ]
        }
      ],
      "states": ["default"],
      "accessibility": {
        "role": "rowheader",
        "ariaLabel": "{teamName}"
      }
    },
    {
      "name": "InningHeaderRow",
      "type": "molecule",
      "description": "이닝 번호(1~12), R, H, E, BB 헤더를 가로로 나열하는 스코어보드 컬럼 헤더 행",
      "props": {
        "totalInnings": {
          "type": "number",
          "required": false,
          "default": 9,
          "description": "표시할 총 이닝 수 (기본 9, 연장 시 최대 12)"
        },
        "currentInning": {
          "type": "number",
          "required": true,
          "description": "현재 진행 이닝 번호 (해당 헤더 셀 하이라이트용)"
        },
        "showExtended": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "연장전(10~12회) 헤더 표시 여부"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "items-center sticky top-0 z-10 bg-gray-900 border-b border-gray-700"
      },
      "children": [
        {
          "element": "div",
          "tailwind": "min-w-[120px] sm:min-w-[160px] h-8 px-2 sm:px-3 flex items-center",
          "children": [
            {
              "element": "span",
              "tailwind": "text-xs text-gray-500 uppercase tracking-wider font-semibold",
              "content": "팀"
            }
          ]
        },
        {
          "element": "div",
          "tailwind": "flex items-center",
          "description": "이닝 헤더 셀 반복 (1 ~ totalInnings)",
          "children": [
            {
              "name": "InningCell",
              "type": "atom",
              "isHeaderProp": true,
              "repeat": "{totalInnings}",
              "description": "이닝 번호 헤더 셀. 현재 이닝 번호와 동일하면 isCurrent=true"
            }
          ]
        },
        {
          "element": "div",
          "tailwind": "flex items-center border-l border-gray-600",
          "children": [
            { "name": "TotalScoreCell", "type": "atom", "isHeaderProp": true, "valueProp": "R" },
            { "name": "StatCell",       "type": "atom", "isHeaderProp": true, "valueProp": "H" },
            { "name": "StatCell",       "type": "atom", "isHeaderProp": true, "valueProp": "E" },
            { "name": "StatCell",       "type": "atom", "isHeaderProp": true, "valueProp": "BB" }
          ]
        }
      ],
      "states": ["default", "extended"],
      "accessibility": {
        "role": "row",
        "ariaLabel": "스코어보드 컬럼 헤더"
      }
    },
    {
      "name": "InningScoreRow",
      "type": "molecule",
      "description": "한 팀의 이닝별 점수 전체 행. TeamInfoRow + InningCell 반복 + TotalScoreCell + StatCell 3개(H/E/BB)로 구성",
      "props": {
        "teamName": {
          "type": "string",
          "required": true,
          "description": "팀 이름"
        },
        "teamShortName": {
          "type": "string",
          "required": true,
          "description": "팀 단축 이름"
        },
        "initials": {
          "type": "string",
          "required": true,
          "description": "팀 이니셜"
        },
        "teamColor": {
          "type": "string",
          "required": false,
          "description": "팀 색상"
        },
        "logoSrc": {
          "type": "string",
          "required": false,
          "description": "팀 로고 URL"
        },
        "scores": {
          "type": "array",
          "required": true,
          "description": "이닝별 점수 배열 (최대 12개, null은 미진행). 예: [0, 1, 0, 2, null, null, null, null, null]"
        },
        "totalRuns": {
          "type": "number",
          "required": true,
          "description": "총 득점 합계"
        },
        "hits": {
          "type": "number",
          "required": true,
          "description": "안타 수 (H)"
        },
        "errors": {
          "type": "number",
          "required": true,
          "description": "에러 수 (E)"
        },
        "walks": {
          "type": "number",
          "required": true,
          "description": "볼넷 수 (BB)"
        },
        "currentInning": {
          "type": "number",
          "required": true,
          "description": "현재 진행 이닝 (해당 셀 하이라이트)"
        },
        "isWinning": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "현재 리드 중 여부"
        },
        "totalInnings": {
          "type": "number",
          "required": false,
          "default": 9,
          "description": "스코어보드 표시 이닝 수"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "items-center border-b border-gray-800 hover:bg-gray-800/30 transition-colors duration-150"
      },
      "children": [
        { "name": "TeamInfoRow", "type": "molecule" },
        {
          "element": "div",
          "tailwind": "flex items-center",
          "description": "이닝 점수 셀 반복 (scores 배열 순회)",
          "children": [
            {
              "name": "InningCell",
              "type": "atom",
              "repeat": "{totalInnings}",
              "description": "각 이닝의 점수 셀. 현재 이닝이면 isCurrent=true"
            }
          ]
        },
        {
          "element": "div",
          "tailwind": "flex items-center",
          "children": [
            { "name": "TotalScoreCell", "type": "atom", "description": "총 득점 R" },
            { "name": "StatCell",       "type": "atom", "statTypeProp": "H", "description": "안타 수" },
            { "name": "StatCell",       "type": "atom", "statTypeProp": "E", "description": "에러 수" },
            { "name": "StatCell",       "type": "atom", "statTypeProp": "BB", "description": "볼넷 수" }
          ]
        }
      ],
      "states": ["default", "winning", "losing"],
      "accessibility": {
        "role": "row",
        "ariaLabel": "{teamName} 점수 행"
      }
    },
    {
      "name": "StatSummaryRow",
      "type": "molecule",
      "description": "스코어보드 하단의 통계 범례/설명 행. H(안타), E(에러), BB(볼넷) 항목별 설명을 색상 점과 라벨로 나열",
      "props": {
        "compact": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "모바일 축약 표시 여부"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "items-center gap-4 sm:gap-6 px-3 py-2"
      },
      "children": [
        {
          "element": "div",
          "tailwind": "flex items-center gap-1.5",
          "children": [
            { "element": "span", "tailwind": "w-2 h-2 rounded-full bg-green-400 shrink-0" },
            { "element": "span", "tailwind": "text-xs text-gray-400", "content": "H 안타" }
          ]
        },
        {
          "element": "div",
          "tailwind": "flex items-center gap-1.5",
          "children": [
            { "element": "span", "tailwind": "w-2 h-2 rounded-full bg-red-400 shrink-0" },
            { "element": "span", "tailwind": "text-xs text-gray-400", "content": "E 에러" }
          ]
        },
        {
          "element": "div",
          "tailwind": "flex items-center gap-1.5",
          "children": [
            { "element": "span", "tailwind": "w-2 h-2 rounded-full bg-blue-400 shrink-0" },
            { "element": "span", "tailwind": "text-xs text-gray-400", "content": "BB 볼넷" }
          ]
        },
        {
          "element": "div",
          "tailwind": "flex items-center gap-1.5 ml-auto",
          "children": [
            { "element": "span", "tailwind": "w-3 h-3 rounded-sm bg-yellow-400 shrink-0" },
            { "element": "span", "tailwind": "text-xs text-gray-400", "content": "현재 이닝" }
          ]
        }
      ],
      "states": ["default"],
      "accessibility": {
        "role": "note",
        "ariaLabel": "스코어보드 범례: H 안타, E 에러, BB 볼넷, 노란색 셀은 현재 이닝"
      }
    },
    {
      "name": "ScoreboardLegend",
      "type": "molecule",
