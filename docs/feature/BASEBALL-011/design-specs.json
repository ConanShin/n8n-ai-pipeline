    {
      "name": "ScoreboardTemplate",
      "type": "template",
      "description": "스코어보드 전체 레이아웃 뼈대. ScoreboardHeader(상단) + ScoreboardTable(중앙) + ScoreboardFooter(하단)를 수직 배치. 카드 스타일 컨테이너로 감쌈",
      "props": {
        "header": {
          "type": "ReactNode",
          "required": true,
          "description": "ScoreboardHeader 슬롯"
        },
        "table": {
          "type": "ReactNode",
          "required": true,
          "description": "ScoreboardTable 슬롯"
        },
        "footer": {
          "type": "ReactNode",
          "required": true,
          "description": "ScoreboardFooter 슬롯"
        },
        "isLoading": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "데이터 로딩 중 여부. true이면 스켈레톤 오버레이 표시"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex-col w-full max-w-3xl mx-auto bg-gray-900 rounded-2xl shadow-2xl overflow-hidden border border-gray-800"
      },
      "children": [
        { "slot": "header", "tailwind": "w-full flex-shrink-0" },
        {
          "element": "div",
          "tailwind": "relative",
          "children": [
            { "slot": "table", "tailwind": "w-full" },
            {
              "element": "div",
              "description": "로딩 스켈레톤 오버레이",
              "tailwind": "absolute inset-0 bg-gray-900/70 backdrop-blur-sm flex items-center justify-center z-20 animate-pulse",
              "visibleWhen": "isLoading",
              "children": [
                { "element": "span", "tailwind": "text-gray-400 text-sm", "content": "데이터 불러오는 중..." }
              ]
            }
          ]
        },
        { "slot": "footer", "tailwind": "w-full flex-shrink-0" }
      ],
      "states": ["default", "loading"],
      "accessibility": {
        "role": "region",
        "ariaLabel": "야구 경기 스코어보드"
      }
    },
    {
      "name": "ScoreboardPage",
      "type": "page",
      "description": "스코어보드 최상위 페이지. 경기 데이터(gameStatus, 이닝 점수, 팀 정보)를 관리하고 ScoreboardTemplate에 전달. 실시간 업데이트 폴링 로직 포함",
      "props": {
        "gameId": {
          "type": "string",
          "required": true,
          "description": "경기 고유 ID (URL 파라미터)"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex-col items-center min-h-screen bg-gray-950 px-4 sm:px-6 py-6 sm:py-10"
      },
      "pageStateMachine": {
        "states": {
          "loading":   { "displays": "ScoreboardTemplate (isLoading=true)",  "description": "경기 데이터 초기 로드 중" },
          "scheduled": { "displays": "ScoreboardTemplate",                   "description": "경기 전 — 이닝 점수 모두 null" },
          "live":      { "displays": "ScoreboardTemplate",                   "description": "경기 진행 중 — 실시간 점수 갱신, currentInning 하이라이트" },
          "final":     { "displays": "ScoreboardTemplate",                   "description": "경기 종료 — FINAL 배지, 전체 이닝 점수 표시" },
          "error":     { "displays": "에러 메시지 컨테이너",                 "description": "데이터 로드 실패 시 재시도 안내" }
        },
        "transitions": [
          { "from": "loading",   "to": "scheduled", "trigger": "gameStatus === 'scheduled' 데이터 수신" },
          { "from": "loading",   "to": "live",       "trigger": "gameStatus === 'live' 데이터 수신" },
          { "from": "loading",   "to": "final",      "trigger": "gameStatus === 'final' 데이터 수신" },
          { "from": "loading",   "to": "error",      "trigger": "API 요청 실패" },
          { "from": "scheduled", "to": "live",       "trigger": "경기 시작 (폴링으로 상태 전환 감지)" },
          { "from": "live",      "to": "final",      "trigger": "경기 종료 (gameStatus → 'final')" }
        ]
      },
      "children": [
        {
          "element": "div",
          "tailwind": "w-full max-w-3xl mb-4 flex items-center justify-between",
          "description": "페이지 상단 네비게이션 바",
          "children": [
            {
              "element": "button",
              "tailwind": "flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-200 transition-colors",
              "content": "← 경기 목록",
              "accessibility": { "role": "button", "ariaLabel": "경기 목록으로 돌아가기" }
            },
            {
              "element": "span",
              "tailwind": "text-xs text-gray-600",
              "content": "KBO 리그"
            }
          ]
        },
        {
          "name": "ScoreboardTemplate",
          "type": "template",
          "children": [
            { "name": "ScoreboardHeader", "type": "organism" },
            { "name": "ScoreboardTable",  "type": "organism" },
            { "name": "ScoreboardFooter", "type": "organism" }
          ]
        },
        {
          "element": "div",
          "description": "에러 상태 컨테이너",
          "tailwind": "w-full max-w-3xl flex flex-col items-center justify-center gap-4 py-20",
          "visibleWhen": "pageState === 'error'",
          "children": [
            { "element": "span", "tailwind": "text-5xl", "content": "⚾" },
            { "element": "p",    "tailwind": "text-gray-400 text-center", "content": "경기 정보를 불러올 수 없습니다." },
            {
              "element": "button",
              "tailwind": "px-6 py-2 rounded-xl bg-gray-700 hover:bg-gray-600 text-gray-200 text-sm font-semibold transition-colors",
              "content": "다시 시도",
              "accessibility": { "role": "button", "ariaLabel": "경기 데이터 다시 불러오기" }
            }
          ]
        }
      ],
      "states": ["loading", "scheduled", "live", "final", "error"],
      "accessibility": {
        "role": "main",
        "ariaLabel": "야구 경기 스코어보드 페이지",
        "lang": "ko"
      }
    }
  ],
  "colorPalette": {
    "background":           "#030712",
    "surface":              "#111827",
    "surfaceAlt":           "#1f2937",
    "surfaceBorder":        "#374151",
    "cardBg":               "#111827",
    "cardBorder":           "#1f2937",
    "currentInningBg":      "#facc15",
    "currentInningText":    "#1a1100",
