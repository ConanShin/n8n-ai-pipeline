# =============================================================================
# n8n AI Agent Pipeline - 환경 변수 설정
# 이 파일을 복사하여 .env 파일을 만드세요: cp .env.example .env
# =============================================================================

# ─── n8n 기본 설정 ──────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# ─── n8n 인증 설정 ──────────────────────────────────────────────────────────
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your-secure-password-here

# ─── LLM Provider ───────────────────────────────────────────────────────────
# Google Antigravity (기본값) — OAuth 인증, API 키 불필요
# 호스트에서 `opencode auth login`으로 Google OAuth 인증 후
# auth.json이 자동 생성됨 (docker-compose가 컨테이너에 마운트)
# auth.json 경로를 커스터마이징하려면 아래 변수 설정:
# OPENCODE_AUTH_JSON=~/.local/share/opencode/auth.json

# Anthropic Claude (대안 — 사용 시 opencode.yaml도 수정 필요)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (대안)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── GitHub 설정 ────────────────────────────────────────────────────────────
# OpenCode 에이전트가 코드를 push할 때 사용
# 필요 권한: repo, workflow
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-target-repo

# ─── Jira 설정 ──────────────────────────────────────────────────────────────
# n8n Jira Trigger 노드에서 사용
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token

# ─── Slack 설정 ─────────────────────────────────────────────────────────────
# n8n Slack 노드에서 사용 (Bot User OAuth Token)
# 필요 권한: chat:write, channels:read
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_CHANNEL=dev-notifications
