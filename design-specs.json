{
  "ticket": "TEST-1007",
  "title": "로그인 페이지 UI 개선",
  "components": [
    {
      "name": "LoginPage",
      "type": "page",
      "description": "Main login page container with responsive layout",
      "props": {},
      "layout": {
        "display": "flex",
        "tailwind": "min-h-screen flex flex-col items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8"
      },
      "children": [
        "LoginForm"
      ],
      "states": [
        "default"
      ],
      "accessibility": {
        "role": "main",
        "ariaLabel": "Login Page"
      }
    },
    {
      "name": "LoginForm",
      "type": "organism",
      "description": "Form containing email/password inputs, submit button, and social login buttons",
      "props": {
        "onSubmit": {
          "type": "function",
          "required": true,
          "description": "Handler for form submission"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "max-w-md w-full space-y-8 bg-white p-8 rounded-xl shadow-md flex flex-col"
      },
      "children": [
        "InputField",
        "PrimaryButton",
        "Divider",
        "SocialLoginGroup"
      ],
      "states": [
        "default",
        "loading",
        "error"
      ],
      "accessibility": {
        "role": "form",
        "ariaLabel": "User Login Form"
      }
    },
    {
      "name": "InputField",
      "type": "atom",
      "description": "Reusable input field for email and password",
      "props": {
        "type": {
          "type": "string",
          "required": true,
          "description": "Input type (email, password)"
        },
        "label": {
          "type": "string",
          "required": true,
          "description": "Input label text"
        },
        "placeholder": {
          "type": "string",
          "required": false,
          "description": "Placeholder text"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex flex-col gap-1.5 w-full"
      },
      "children": [],
      "states": [
        "default",
        "focus",
        "error"
      ],
      "accessibility": {
        "role": "textbox",
        "ariaLabel": "Input field"
      }
    },
    {
      "name": "PrimaryButton",
      "type": "atom",
      "description": "Main submission button",
      "props": {
        "label": {
          "type": "string",
          "required": true,
          "description": "Button text"
        },
        "isLoading": {
          "type": "boolean",
          "required": false,
          "description": "Loading state indicator"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "w-full flex justify-center py-2.5 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors"
      },
      "children": [],
      "states": [
        "default",
        "hover",
        "active",
        "disabled",
        "loading"
      ],
      "accessibility": {
        "role": "button",
        "ariaLabel": "Submit Login"
      }
    },
    {
      "name": "Divider",
      "type": "atom",
      "description": "Visual divider with 'or' text for separating email and social login",
      "props": {},
      "layout": {
        "display": "flex",
        "tailwind": "relative flex items-center py-5 w-full before:flex-grow before:border-t before:border-gray-300 after:flex-grow after:border-t after:border-gray-300"
      },
      "children": [],
      "states": [
        "default"
      ],
      "accessibility": {
        "role": "separator",
        "ariaLabel": "or"
      }
    },
    {
      "name": "SocialLoginGroup",
      "type": "molecule",
      "description": "Container for social login buttons",
      "props": {},
      "layout": {
        "display": "grid",
        "tailwind": "grid grid-cols-2 gap-4 w-full sm:flex sm:flex-col sm:gap-3"
      },
      "children": [
        "SocialLoginButton"
      ],
      "states": [
        "default"
      ],
      "accessibility": {
        "role": "group",
        "ariaLabel": "Social Login Options"
      }
    },
    {
      "name": "SocialLoginButton",
      "type": "atom",
      "description": "Button for OAuth login (e.g., Google, Apple, GitHub)",
      "props": {
        "provider": {
          "type": "string",
          "required": true,
          "description": "Name of the social provider"
        },
        "icon": {
          "type": "string",
          "required": true,
          "description": "Provider icon identifier"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "w-full inline-flex justify-center items-center gap-2 py-2 px-4 border border-gray-300 rounded-md shadow-sm bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors"
      },
      "children": [],
      "states": [
        "default",
        "hover",
        "active",
        "disabled"
      ],
      "accessibility": {
        "role": "button",
        "ariaLabel": "Login with social provider"
      }
    }
  ],
  "colorPalette": {
    "primary": "#4F46E5",
    "secondary": "#6B7280",
    "background": "#F9FAFB",
    "surface": "#FFFFFF",
    "text-primary": "#111827",
    "border": "#D1D5DB"
  },
  "interactions": [
    {
      "trigger": "click",
      "action": "Submit login form credentials via PrimaryButton"
    },
    {
      "trigger": "click",
      "action": "Initiate social OAuth redirect via SocialLoginButton"
    },
    {
      "trigger": "hover",
      "action": "Highlight buttons and show focus rings on InputFields"
    }
  ]
}