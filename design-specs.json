{
  "ticket": "BASEBALL-003",
  "title": "웹 기반 야구 배팅 게임",
  "description": "타이밍에 맞춰 화면을 탭하여 날아오는 공을 치는 리듬 기반 야구 게임. 점수는 홈런/1~3루타/스트라이크로 구분되며 기회는 3번.",
  "components": [
    {
      "name": "ScoreLabel",
      "type": "atom",
      "description": "홈런, 1루타, 2루타, 3루타, 스트라이크 등 개별 타격 결과를 표시하는 뱃지 형태의 라벨",
      "props": {
        "result": {
          "type": "string",
          "required": true,
          "description": "'homerun' | '3base' | '2base' | '1base' | 'strike'"
        },
        "visible": {
          "type": "boolean",
          "required": true,
          "description": "결과 라벨 표시 여부"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "inline-flex items-center justify-center px-4 py-2 rounded-full text-white font-extrabold text-2xl sm:text-4xl tracking-widest shadow-lg"
      },
      "variants": {
        "homerun": {
          "tailwind": "bg-yellow-400 text-yellow-900 ring-4 ring-yellow-300 animate-bounce",
          "content": "⚾ HOMERUN!"
        },
        "3base": {
          "tailwind": "bg-green-500 text-white ring-4 ring-green-300",
          "content": "3루타!"
        },
        "2base": {
          "tailwind": "bg-blue-500 text-white ring-4 ring-blue-300",
          "content": "2루타!"
        },
        "1base": {
          "tailwind": "bg-indigo-400 text-white ring-4 ring-indigo-300",
          "content": "1루타!"
        },
        "strike": {
          "tailwind": "bg-red-500 text-white ring-4 ring-red-300",
          "content": "STRIKE!"
        }
      },
      "states": ["hidden", "visible"],
      "accessibility": {
        "role": "status",
        "ariaLive": "polite",
        "ariaLabel": "타격 결과 표시"
      }
    },
    {
      "name": "OutIndicator",
      "type": "atom",
      "description": "현재 남은 기회(아웃 카운트)를 야구공 아이콘으로 표시. 총 3개, 사용된 기회는 비활성 처리",
      "props": {
        "totalChances": {
          "type": "number",
          "required": false,
          "description": "전체 기회 수 (기본값: 3)"
        },
        "usedChances": {
          "type": "number",
          "required": true,
          "description": "사용된 기회 수 (스트라이크/아웃 횟수)"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex items-center gap-2"
      },
      "children": [
        {
          "element": "span",
          "description": "활성 공 아이콘 (기회 남음)",
          "tailwind": "w-6 h-6 rounded-full bg-white border-2 border-gray-300 shadow-inner"
        },
        {
          "element": "span",
          "description": "비활성 공 아이콘 (기회 소진)",
          "tailwind": "w-6 h-6 rounded-full bg-red-500 border-2 border-red-700 shadow-inner opacity-80"
        }
      ],
      "states": ["chance-full", "chance-partial", "chance-empty"],
      "accessibility": {
        "role": "img",
        "ariaLabel": "남은 기회: {usedChances}번 사용 / 3번"
      }
    },
    {
      "name": "TimingBar",
      "type": "atom",
      "description": "공이 날아오는 타이밍을 시각적으로 나타내는 수평 진행 바. 이동하는 마커가 '타격 존'에 들어왔을 때 탭하면 타격 성공",
      "props": {
        "progress": {
          "type": "number",
          "required": true,
          "description": "공의 현재 위치 비율 (0~1)"
        },
        "hitZoneStart": {
          "type": "number",
          "required": true,
          "description": "타격 존 시작 비율 (예: 0.42)"
        },
        "hitZoneEnd": {
          "type": "number",
          "required": true,
          "description": "타격 존 끝 비율 (예: 0.58)"
        },
        "perfectZoneStart": {
          "type": "number",
          "required": true,
          "description": "퍼펙트(홈런) 존 시작 비율 (예: 0.48)"
        },
        "perfectZoneEnd": {
          "type": "number",
          "required": true,
          "description": "퍼펙트(홈런) 존 끝 비율 (예: 0.52)"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "relative w-full h-6 rounded-full bg-gray-700 overflow-hidden"
      },
      "children": [
        {
          "element": "div",
          "description": "타격 가능 존 (초록 영역)",
          "tailwind": "absolute top-0 h-full bg-green-400 opacity-50 rounded"
        },
        {
          "element": "div",
          "description": "퍼펙트(홈런) 존 (노란 영역)",
          "tailwind": "absolute top-0 h-full bg-yellow-300 opacity-80 rounded"
        },
        {
          "element": "div",
          "description": "이동하는 공 마커",
          "tailwind": "absolute top-1/2 -translate-y-1/2 w-5 h-5 rounded-full bg-white shadow-md border-2 border-gray-400 transition-transform"
        }
      ],
      "states": ["idle", "moving", "hit", "miss"],
      "accessibility": {
        "role": "progressbar",
        "ariaLabel": "타이밍 바 — 공이 타격 존에 들어오면 탭하세요",
        "ariaValueMin": "0",
        "ariaValueMax": "100"
      }
    },
    {
      "name": "ActionButton",
      "type": "atom",
      "description": "플레이어가 탭/클릭하여 배트를 휘두르는 메인 액션 버튼. 화면 하단 중앙에 위치하며 대형 터치 영역 제공",
      "props": {
        "disabled": {
          "type": "boolean",
          "required": false,
          "description": "버튼 비활성 여부 (공이 날아오지 않을 때)"
        },
        "onSwing": {
          "type": "function",
          "required": true,
          "description": "배트 휘두르기 핸들러"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex items-center justify-center w-36 h-36 sm:w-48 sm:h-48 rounded-full cursor-pointer select-none active:scale-90 transition-transform duration-75"
      },
      "variants": {
        "default": {
          "tailwind": "bg-amber-500 hover:bg-amber-400 shadow-xl ring-4 ring-amber-300 text-white text-5xl"
        },
        "swinging": {
          "tailwind": "bg-amber-300 scale-90 shadow-inner ring-4 ring-amber-200 text-white text-5xl"
        },
        "disabled": {
          "tailwind": "bg-gray-600 opacity-50 cursor-not-allowed ring-4 ring-gray-500 text-gray-400 text-5xl"
        }
      },
      "children": [
        {
          "element": "span",
          "content": "🏏",
          "tailwind": "text-5xl sm:text-6xl drop-shadow"
        }
      ],
      "states": ["default", "swinging", "disabled"],
      "accessibility": {
        "role": "button",
        "ariaLabel": "배트 휘두르기 — 탭하세요",
        "ariaPressed": "false"
      }
    },
    {
      "name": "ResultBadge",
      "type": "atom",
      "description": "최종 게임 종료 후 전체 결과를 요약하는 뱃지 (예: 만루 홈런왕, 삼진 아웃)",
      "props": {
        "grade": {
          "type": "string",
          "required": true,
          "description": "'perfect' | 'great' | 'good' | 'out'"
        },
        "label": {
          "type": "string",
          "required": true,
          "description": "결과 텍스트 (예: '만루 홈런왕!')"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "inline-flex flex-col items-center gap-1 px-8 py-4 rounded-2xl shadow-2xl text-center font-black"
      },
      "variants": {
        "perfect": { "tailwind": "bg-yellow-400 text-yellow-900 text-4xl" },
        "great":   { "tailwind": "bg-green-400 text-green-900 text-3xl" },
        "good":    { "tailwind": "bg-blue-400 text-blue-900 text-3xl" },
        "out":     { "tailwind": "bg-red-500 text-white text-3xl" }
      },
      "states": ["default"],
      "accessibility": {
        "role": "status",
        "ariaLabel": "게임 결과"
      }
    },
    {
      "name": "ScoreBoard",
      "type": "molecule",
      "description": "현재 점수, 남은 기회, 현재 회차를 한 줄에 표시하는 HUD 상단 패널",
      "props": {
        "score": {
          "type": "number",
          "required": true,
          "description": "현재 누적 점수"
        },
        "currentInning": {
          "type": "number",
          "required": true,
          "description": "현재 타석 번호 (1~3)"
        },
        "usedChances": {
          "type": "number",
          "required": true,
          "description": "사용된 기회 수"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex items-center justify-between w-full px-4 py-3 bg-gray-900 bg-opacity-80 backdrop-blur rounded-xl shadow-md"
      },
      "children": [
        {
          "element": "div",
          "tailwind": "flex flex-col items-start gap-0.5",
          "children": [
            {
              "element": "span",
              "tailwind": "text-xs text-gray-400 uppercase tracking-widest",
              "content": "SCORE"
            },
            {
              "element": "span",
              "tailwind": "text-3xl font-black text-yellow-300 tabular-nums",
              "content": "{score}"
            }
          ]
        },
        {
          "element": "div",
          "tailwind": "flex flex-col items-center gap-0.5",
          "children": [
            {
              "element": "span",
              "tailwind": "text-xs text-gray-400 uppercase tracking-widest",
              "content": "INNING"
            },
            {
              "element": "span",
              "tailwind": "text-3xl font-black text-white tabular-nums",
              "content": "{currentInning} / 3"
            }
          ]
        },
        {
          "element": "div",
          "tailwind": "flex flex-col items-end gap-1",
          "children": [
            {
              "element": "span",
              "tailwind": "text-xs text-gray-400 uppercase tracking-widest",
              "content": "CHANCE"
            },
            {
              "name": "OutIndicator",
              "type": "atom"
            }
          ]
        }
      ],
      "states": ["default", "last-chance"],
      "accessibility": {
        "role": "region",
        "ariaLabel": "점수판"
      }
    },
    {
      "name": "BallPitchAnimation",
      "type": "molecule",
      "description": "투수에서 포수 방향으로 날아오는 야구공 애니메이션 영역. 공의 크기가 점점 커지며 타이밍을 암시",
      "props": {
        "pitching": {
          "type": "boolean",
          "required": true,
          "description": "공이 현재 날아오는 중인지 여부"
        },
        "progress": {
          "type": "number",
          "required": true,
          "description": "공의 이동 진행 비율 (0~1), 1에 가까울수록 타자에게 근접"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "relative flex items-center justify-center w-full aspect-video bg-gradient-to-b from-sky-400 to-green-600 rounded-2xl overflow-hidden shadow-inner"
      },
      "children": [
        {
          "element": "div",
          "description": "야구장 배경 (원근감 표현용 마운드/다이아몬드 그래픽)",
          "tailwind": "absolute inset-0 opacity-60"
        },
        {
          "element": "div",
          "description": "날아오는 야구공 (progress에 따라 크기/위치 변화)",
          "tailwind": "absolute rounded-full bg-white shadow-lg border-2 border-gray-200 transition-all duration-100",
          "sizeNote": "progress=0: w-3 h-3 top-1/4, progress=1: w-16 h-16 bottom-1/3 — 크기와 Y좌표는 progress에 비례"
        },
        {
          "element": "div",
          "description": "투구 대기 상태 텍스트",
          "tailwind": "absolute inset-0 flex items-center justify-center text-white text-xl font-bold opacity-70",
          "content": "READY..."
        }
      ],
      "states": ["idle", "pitching", "hit-success", "hit-miss"],
      "accessibility": {
        "role": "img",
        "ariaLabel": "야구공 투구 애니메이션"
      }
    },
    {
      "name": "TimingZone",
      "type": "molecule",
      "description": "타이밍 바와 '지금 탭!' 힌트 텍스트를 결합한 타이밍 입력 영역",
      "props": {
        "progress": {
          "type": "number",
          "required": true,
          "description": "공의 타이밍 진행 비율 (0~1)"
        },
        "showHint": {
          "type": "boolean",
          "required": true,
          "description": "타격 존 진입 시 힌트 텍스트 표시 여부"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex flex-col items-center gap-2 w-full px-4"
      },
      "children": [
        {
          "element": "div",
          "tailwind": "flex justify-between w-full text-xs text-gray-400 mb-1",
          "children": [
            { "element": "span", "content": "← 너무 빠름" },
            { "element": "span", "content": "지금!" },
            { "element": "span", "content": "너무 느림 →" }
          ]
        },
        {
          "name": "TimingBar",
          "type": "atom"
        },
        {
          "element": "span",
          "description": "타격 힌트 (타격 존 진입 시 pulse 애니메이션)",
          "tailwind": "text-green-400 font-extrabold text-lg tracking-wider animate-pulse",
          "content": "지금 탭!",
          "visibleWhen": "showHint === true"
        }
      ],
      "states": ["idle", "in-hit-zone", "in-perfect-zone"],
      "accessibility": {
        "role": "region",
        "ariaLabel": "타이밍 입력 구역"
      }
    },
    {
      "name": "ResultOverlay",
      "type": "molecule",
      "description": "타격 직후 화면 중앙에 오버레이로 표시되는 즉시 결과 피드백 (홈런/루타/스트라이크)",
      "props": {
        "result": {
          "type": "string",
          "required": false,
          "description": "'homerun' | '3base' | '2base' | '1base' | 'strike' | null"
        },
        "visible": {
          "type": "boolean",
          "required": true,
          "description": "오버레이 표시 여부"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "absolute inset-0 flex items-center justify-center pointer-events-none z-20"
      },
      "children": [
        {
          "element": "div",
          "tailwind": "flex flex-col items-center gap-3 animate-fade-in-out",
          "children": [
            { "name": "ScoreLabel", "type": "atom" },
            {
              "element": "span",
              "description": "점수 증가량 표시",
              "tailwind": "text-white text-2xl font-bold drop-shadow-lg",
              "content": "+ {scoreIncrement}점"
            }
          ]
        }
      ],
      "states": ["hidden", "show-homerun", "show-hit", "show-strike"],
      "accessibility": {
        "role": "alert",
        "ariaLive": "assertive",
        "ariaLabel": "타격 결과 알림"
      }
    },
    {
      "name": "GameHUD",
      "type": "organism",
      "description": "게임 플레이 화면 상단에 고정되는 HUD(Head-Up Display). 점수판과 게임 상태를 포함",
      "props": {
        "score": {
          "type": "number",
          "required": true,
          "description": "현재 누적 점수"
        },
        "currentInning": {
          "type": "number",
          "required": true,
          "description": "현재 타석 번호"
        },
        "usedChances": {
          "type": "number",
          "required": true,
          "description": "사용된 기회 수"
        },
        "gamePhase": {
          "type": "string",
          "required": true,
          "description": "'ready' | 'pitching' | 'result' | 'finished'"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "sticky top-0 z-30 flex flex-col gap-2 w-full px-4 pt-4 pb-2 bg-gray-950 bg-opacity-90 backdrop-blur-sm"
      },
      "children": [
        { "name": "ScoreBoard", "type": "molecule" },
        {
          "element": "div",
          "tailwind": "w-full h-px bg-gray-700 mt-1"
        }
      ],
      "states": ["default", "last-chance", "game-over"],
      "accessibility": {
        "role": "banner",
        "ariaLabel": "게임 정보 헤더"
      }
    },
    {
      "name": "BattingStage",
      "type": "organism",
      "description": "실제 타격이 이루어지는 메인 게임 스테이지. 공 애니메이션, 타이밍 바, 배트 버튼, 결과 오버레이를 통합 관리",
      "props": {
        "pitching": {
          "type": "boolean",
          "required": true,
          "description": "투구 진행 중 여부"
        },
        "progress": {
          "type": "number",
          "required": true,
          "description": "투구 진행 비율 (0~1)"
        },
        "result": {
          "type": "string",
          "required": false,
          "description": "마지막 타격 결과"
        },
        "canSwing": {
          "type": "boolean",
          "required": true,
          "description": "현재 배트 휘두르기 가능 여부"
        },
        "onSwing": {
          "type": "function",
          "required": true,
          "description": "배트 휘두르기 이벤트 핸들러"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "relative flex flex-col items-center gap-6 w-full px-4 py-6 flex-1"
      },
      "children": [
        { "name": "BallPitchAnimation", "type": "molecule" },
        { "name": "TimingZone",         "type": "molecule" },
        { "name": "ActionButton",       "type": "atom" },
        { "name": "ResultOverlay",      "type": "molecule" }
      ],
      "states": ["ready", "pitching", "hit-success", "hit-miss", "between-pitch"],
      "accessibility": {
        "role": "main",
        "ariaLabel": "타격 게임 스테이지"
      }
    },
    {
      "name": "ResultScreen",
      "type": "organism",
      "description": "3번의 기회를 모두 사용한 뒤 표시되는 최종 결과 화면. 타격 이력과 총점을 보여주고 재도전/홈으로 버튼 제공",
      "props": {
        "totalScore": {
          "type": "number",
          "required": true,
          "description": "최종 누적 점수"
        },
        "history": {
          "type": "array",
          "required": true,
          "description": "타석별 결과 배열 (예: ['homerun', '1base', 'strike'])"
        },
        "onRestart": {
          "type": "function",
          "required": true,
          "description": "게임 재시작 핸들러"
        },
        "onHome": {
          "type": "function",
          "required": true,
          "description": "홈 화면 이동 핸들러"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex flex-col items-center justify-center gap-8 w-full min-h-screen bg-gray-950 px-6 py-12"
      },
      "children": [
        {
          "element": "h2",
          "tailwind": "text-3xl sm:text-4xl font-black text-white tracking-tight",
          "content": "게임 종료!"
        },
        { "name": "ResultBadge", "type": "atom" },
        {
          "element": "div",
          "tailwind": "flex flex-col gap-2 w-full max-w-xs",
          "description": "타석별 결과 이력 목록",
          "children": [
            {
              "element": "div",
              "tailwind": "flex items-center justify-between px-4 py-2 bg-gray-800 rounded-lg",
              "children": [
                {
                  "element": "span",
                  "tailwind": "text-gray-400 text-sm",
                  "content": "{n}타석"
                },
                { "name": "ScoreLabel", "type": "atom" }
              ]
            }
          ]
        },
        {
          "element": "div",
