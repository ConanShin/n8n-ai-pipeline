{
  "ticket": "TEST-1007",
  "title": "로그인 페이지 UI 개선",
  "components": [
    {
      "name": "SocialButton",
      "type": "atom",
      "description": "Button for social login providers",
      "props": {
        "provider": {
          "type": "string",
          "required": true,
          "description": "The name of the social provider (e.g., Google, GitHub)"
        },
        "icon": {
          "type": "ReactNode",
          "required": true,
          "description": "The provider's icon"
        },
        "onClick": {
          "type": "function",
          "required": true,
          "description": "Handler for click event"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "w-full flex items-center justify-center gap-2 px-4 py-2 border border-gray-300 rounded-md bg-white hover:bg-gray-50 transition-colors text-sm font-medium text-gray-700"
      },
      "children": [
        "icon",
        "text"
      ],
      "states": [
        "default",
        "hover",
        "focus",
        "loading",
        "disabled"
      ],
      "accessibility": {
        "role": "button",
        "ariaLabel": "Sign in with ${provider}"
      }
    },
    {
      "name": "PrimaryButton",
      "type": "atom",
      "description": "Main submission button for the login form",
      "props": {
        "label": {
          "type": "string",
          "required": true,
          "description": "Button text"
        },
        "type": {
          "type": "string",
          "required": false,
          "description": "Button type (submit, button)"
        },
        "isLoading": {
          "type": "boolean",
          "required": false,
          "description": "Loading state"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "w-full flex items-center justify-center px-4 py-2 text-white bg-blue-600 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors font-semibold"
      },
      "children": [
        "text",
        "loadingSpinner"
      ],
      "states": [
        "default",
        "hover",
        "focus",
        "loading",
        "disabled"
      ],
      "accessibility": {
        "role": "button",
        "ariaLabel": "Submit login form"
      }
    },
    {
      "name": "InputField",
      "type": "molecule",
      "description": "Input field with a label and optional error message",
      "props": {
        "id": {
          "type": "string",
          "required": true,
          "description": "Input ID for accessibility"
        },
        "label": {
          "type": "string",
          "required": true,
          "description": "Label text"
        },
        "type": {
          "type": "string",
          "required": true,
          "description": "Input type (email, password)"
        },
        "placeholder": {
          "type": "string",
          "required": false,
          "description": "Placeholder text"
        },
        "error": {
          "type": "string",
          "required": false,
          "description": "Error message"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "flex flex-col gap-1.5 w-full"
      },
      "children": [
        "label",
        "input",
        "errorText"
      ],
      "states": [
        "default",
        "focus",
        "error",
        "disabled"
      ],
      "accessibility": {
        "role": "textbox",
        "ariaLabel": "${label} input"
      }
    },
    {
      "name": "SocialLoginGroup",
      "type": "molecule",
      "description": "Group of social login buttons separated by a divider",
      "props": {},
      "layout": {
        "display": "flex",
        "tailwind": "flex flex-col gap-3 w-full sm:flex-row sm:justify-between mt-4"
      },
      "children": [
        "SocialButton(Google)",
        "SocialButton(GitHub)",
        "SocialButton(Kakao)"
      ],
      "states": [
        "default"
      ],
      "accessibility": {
        "role": "group",
        "ariaLabel": "Social login options"
      }
    },
    {
      "name": "LoginForm",
      "type": "organism",
      "description": "Complete login form containing credentials inputs, primary button, and social login options",
      "props": {
        "onSubmit": {
          "type": "function",
          "required": true,
          "description": "Submit handler"
        }
      },
      "layout": {
        "display": "flex",
        "tailwind": "w-full max-w-md p-6 sm:p-8 bg-white rounded-2xl shadow-xl border border-gray-100 flex flex-col gap-6"
      },
      "children": [
        "FormHeader",
        "InputField(Email)",
        "InputField(Password)",
        "PrimaryButton",
        "Divider",
        "SocialLoginGroup"
      ],
      "states": [
        "default",
        "submitting",
        "error"
      ],
      "accessibility": {
        "role": "form",
        "ariaLabel": "User login form"
      }
    },
    {
      "name": "LoginPage",
      "type": "page",
      "description": "The main login page layout providing responsive centering for the form",
      "props": {},
      "layout": {
        "display": "flex",
        "tailwind": "min-h-screen w-full flex items-center justify-center bg-gray-50 p-4 sm:p-6 lg:p-8"
      },
      "children": [
        "LoginForm"
      ],
      "states": [
        "default",
        "loading"
      ],
      "accessibility": {
        "role": "main",
        "ariaLabel": "Login Page"
      }
    }
  ],
  "colorPalette": {
    "primary": "#2563EB",
    "primaryHover": "#1D4ED8",
    "surface": "#FFFFFF",
    "background": "#F9FAFB",
    "textPrimary": "#111827",
    "textSecondary": "#4B5563",
    "border": "#D1D5DB",
    "error": "#EF4444"
  },
  "interactions": [
    {
      "trigger": "submit",
      "action": "Validates email and password, shows loading state on PrimaryButton, and triggers authentication API call."
    },
    {
      "trigger": "click",
      "action": "SocialButton click redirects to the respective OAuth provider."
    },
    {
      "trigger": "focus",
      "action": "InputField receives primary color ring to indicate active state."
    }
  ]
}